 #include "nvn_present_aa.inc"
+#include "nvn_hdr.h"   // HDR 出屏：与 s2a_hdr_itm_params() 同一组常数
+// 出屏扩张参数 float4(knee_lo, knee_hi - knee_lo, head, 已初始化)；自动 HDR 的直方图结论写这里，present 读它。
+static float g_hdr_knee[4] = {0.55f, 0.45f, 2.0f, 0.0f};
+// knee 的原子发布槽：CPU 侧（完成回调）写，渲染线程读，避免 (lo, hi-lo) 撕裂。见 nvn_hdr.h
+static unsigned long long g_hdr_knee_pub = 0ull;
+static s2a_hdr_fmt_guard g_hdr_fmt_guard;   // 16F 画布连续取不到 drawable 时降级到 8 位（见 nvn_hdr.h）
+static int g_hdr_want16;                    // 1 = 起局确实要了 16F 画布（降级后据此决定要不要试探回来）
+// 色域 / 饱和度（Crop16 的 extra）：(sat, p3, 0, 0)。缺省 1.0 / 0 → 缺省包逐字节同以前；环境变量见 nvn_hdr.h
+static float g_hdr_extra[4] = {1.0f, 0.0f, 0.0f, 0.0f};
+static int g_hdr_extra_done;
+static void hdr_extra_once(void) {
+    if (g_hdr_extra_done) return;
+    // head 从来没跟着 S2A_HDR_HEADROOM / EDR 探针走过：g_hdr_knee[2] 一直是静态初值 2.0，
+    // 于是 SDR 屏（headroom 1.0）也按 2.0 扩张、XDR 屏（4.0）只用到一半。这里补齐。
+    {
+        s2a_hdr_itm itm = s2a_hdr_itm_params();
