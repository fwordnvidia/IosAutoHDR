+    }
+    g_hdr_extra[0] = s2a_hdr_sat(); g_hdr_extra[1] = s2a_hdr_p3();
+    g_hdr_extra[2] = (float)s2a_hdr_map();   /* 0 = knee（缺省）, 1 = BT.2408 内容映射 */
+    g_hdr_extra_done = 1;
+    if (g_hdr_extra[2] != 0.0f) MLOG("HDR: 内容映射 BT.2408（L_out = head * L^1.15，纸白以下也会抬）");
+    if (g_hdr_extra[0] != 1.0f || g_hdr_extra[1] != 0.0f) MLOG("HDR: saturation %.2f, Display P3 mix %.2f", g_hdr_extra[0], g_hdr_extra[1]);
+    // 上屏饱和度已与 C 侧同算法（CIELAB 缩放 a*/b*，见 src_msl_hdr 的 s2a_sat），
+    // 所以不再有「两套算法」的告警；这里只记一行参数，方便和 hdr_convert 的输出对照。
+    if (g_hdr_extra[0] != 1.0f)
+        MLOG("HDR: saturation %.2f（CIELAB，与 hdr_convert/hdr_ref 同算法）", (double)g_hdr_extra[0]);
+}
+// 每帧跟着「当前」EDR 上界走一次：Apple 的说明是 1.0 对应 SDR 最大亮度、可用 headroom
+//   「随时」可能在变（用户拖亮度滑块、换屏），并要求把内容映射进 [0, 当前上界]。
+//   一直用起局时的值会让画面在亮度变化后过亮或欠亮；死区 1% 避免读数抖动带出闪烁。
