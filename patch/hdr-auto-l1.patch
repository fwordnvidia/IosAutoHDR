+    if (!(cur >= 1.0f)) return;
+    float was = g_hdr_knee[2];
+    float now = s2a_hdr_head_track(was, cur);
+    if (now == was) return;
+    s2a_hdr_head_set(now);
+    g_hdr_knee[2] = s2a_hdr_itm_params().head;
+    MLOG("HDR: headroom %.2f -> %.2f（EDR 上界变化）", (double)was, (double)g_hdr_knee[2]);
+}
 static void present_pipeline(MTLPixelFormat format) {
     present_options();
+    hdr_extra_once();
     if (!g_blit_pso || g_blit_fmt != format) {
+        // 8 位直通上屏：只做裁剪采样（逐字节与旧行为一致）
         static const char *src_msl =
             "#include <metal_stdlib>\nusing namespace metal;\n"
             "struct V { float4 p [[position]]; float2 uv; };\n"
