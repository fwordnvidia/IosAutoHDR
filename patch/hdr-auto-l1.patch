index 00000000..7bf1908e
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_hdr.h
@@ -0,0 +1,541 @@
+// HDR 出屏（S2A_HDR_OUTPUT）：直连层的 drawable 换成 RGBA16Float，层声明 EDR，
+//   上屏着色器把 sRGB 编码值线性化后按亮度扩张 headroom（ITM，反色调映射），让画面里本来就有的高光进到 >1.0。
+// 只做精度不做扩张不算 HDR：线性 1.0 落在 SDR 参考白上，观感与 SDR 一模一样，只是少了 8 位量化。
+//   头文件里那条 gain 曲线才是可见变化的那一半。
+//
+// 本文件是纯 C，单测 graphics/nvn/tests/t_hdr.c 手算期望；MSL 侧（nvn_mtl.m present_pipeline 的 16F 分支）
+//   必须用同一组常数与同一条曲线——改这里就同步改那段字符串，两边任一改动都要让 t_hdr 先红。
+#ifndef NVN_HDR_H
+#define NVN_HDR_H
+
+#include <math.h>
+#include <stdio.h>   // snprintf：诊断行（S2A_HDR_LOG）
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>   // strcasecmp
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+    float head;     // 线性 1.0 之上的可用倍数（S2A_HDR_HEADROOM，缺省 2.0，钳 [1,4]）
+    float knee_lo;  // 拐点下沿：亮度在这以下完全不动（0.55）
+    float knee_hi;  // 拐点上沿：亮度到这里拿满 head（1.0）
+} s2a_hdr_itm;
+
+// 运行期的 headroom 覆盖。Apple 的说明是：1.0 对应 SDR 最大亮度，可用 headroom
+//   「随时」可能在变（用户拖亮度滑块、换屏），要读当前上界并把内容映射进 [0, 上界]。
+//   所以 head 不能只在起局时从环境变量取一次：宿主每帧读一次当前上界，变化超过死区就写这里，
+//   上屏 buffer 与 CPU 侧 ITM 从此读同一个值（否则两侧会各按各的 head 扩张）。
+//   0 表示「没有覆盖」，回落到 S2A_HDR_HEADROOM / 缺省 2.0。
+static float s2a_hdr_head_live;
+static inline void s2a_hdr_head_set(float h) {
+    if (!(h >= 1.0f)) h = 1.0f;
+    if (h > 4.0f) h = 4.0f;
+    s2a_hdr_head_live = h;
+}
+static inline void s2a_hdr_head_clear(void) { s2a_hdr_head_live = 0.0f; }
+
+// 变化死区：相对差小于 S2A_HDR_HEAD_DEADBAND 就不动（读数抖一下不该让画面闪）。
+#define S2A_HDR_HEAD_DEADBAND 0.01f
+// 返回应当采用的新 head：|cur-prev| / prev <= 死区时保持 prev。
+static inline float s2a_hdr_head_track(float prev, float cur) {
+    if (!(cur >= 1.0f)) return prev;
+    if (cur > 4.0f) cur = 4.0f;
+    if (!(prev >= 1.0f)) return cur;
+    float d = (cur - prev) / prev;
+    if (d < 0.0f) d = -d;
+    return d <= S2A_HDR_HEAD_DEADBAND ? prev : cur;
+}
+
+// ---- 16F 画布取不到 drawable 时的回退 ------------------------------------------------------
+// 为什么需要：`S2A_HDR_FMT=1` 会把 CAMetalLayer 的 pixelFormat 改成 RGBA16Float，
+// 由系统决定给不给这个格式的可绘制对象。不支持时 `[layer nextDrawable]` 每一步都返回 nil，
+// 而主循环里原本只是 `if (!dr) return 0;` —— 没有日志、没有回退，表现就是**永久黑屏**。
+// （真机三格矩阵 T1/T2 要判的正是这个假设。）这层守卫把「静默黑屏」变成「一秒后自动降级到 8 位」。
+//
+// 判据用「连续 N 帧取不到」而不是「第一帧就退」：首帧拿不到 drawable 是正常的
+// （窗口还没上屏、后台切换、画布尺寸正在变），过早退回会让 HDR 在起局阶段被误关。
+#define S2A_HDR_NIL_LIMIT 60   // 60 帧 ≈ 1 秒 @60 Hz
+
+// 降级之后**必须**还有回头路：外接 SDR 屏 → 内建 XDR 屏、系统 HDR 开关被重新打开、
+// 窗口从分屏拖回全屏……这些都会让 16F 画布重新可用。只降不升等于「一次意外换来永久 HDR 关」。
+// 策略：降级后按固定节奏试探 16F，失败就指数退避（600 帧起，上限 8 倍 ≈ 80 秒），
+// 一旦 16F 稳定拿到 drawable 就把退避复位。试探本身不改任何持久设置，失败只是回到 8 位。
+#define S2A_HDR_REARM_FRAMES 600   // 首次重试间隔：600 帧 ≈ 10 秒 @60 Hz
+#define S2A_HDR_REARM_MAX 8        // 退避上限倍数（600*8 ≈ 80 秒 @60 Hz）
+
+typedef struct {
+    int nil_run;   // 连续取不到 drawable 的帧数
+    int latched;   // 1 = 已经降级过（守卫不再计 nil 帧，改由 rearm 定时试探）
+    int wait;      // 距下次试探还有多久（帧）
+    int step;      // 本次试探的间隔（帧），失败后翻倍到上限
+} s2a_hdr_fmt_guard;
+
+// 每帧调用一次。got_drawable=0 表示 nextDrawable 返回了 nil。
+// want16 表示调用方当前**正在用** 16F 画布（否则无需守卫）。
+// 返回 1 = 就在这一帧执行降级（恰好返回一次，随后 latched=1）。
+static inline int s2a_hdr_fmt_guard_step(s2a_hdr_fmt_guard *g, int got_drawable, int want16) {
+    if (!g) return 0;
+    if (got_drawable) { g->nil_run = 0; return 0; }
+    if (!want16 || g->latched) return 0;
+    if (g->nil_run < S2A_HDR_NIL_LIMIT) g->nil_run++;
+    if (g->nil_run < S2A_HDR_NIL_LIMIT) return 0;
+    g->latched = 1;
+    g->wait = 0;
+    if (g->step < S2A_HDR_REARM_FRAMES) g->step = S2A_HDR_REARM_FRAMES;   // 保住已有的退避倍数
+    return 1;
+}
+
+// 每帧调用一次（仅在已降级时才有动作）。want16 = 调用方**希望**用 16F 画布
+// （不是「当前是不是 16F」——降级之后当前必然不是）。
+// 返回 1 = 就在这一帧把画布切回 16F 再试一次；失败会再次降级，并按退避放大间隔。
+static inline int s2a_hdr_fmt_guard_rearm(s2a_hdr_fmt_guard *g, int want16) {
+    if (!g || !g->latched || !want16) return 0;
+    if (g->step <= 0) g->step = S2A_HDR_REARM_FRAMES;
+    if (g->wait < g->step) { g->wait++; return 0; }
+    g->wait = 0;
+    // 失败退避：下一次等更久，上限 S2A_HDR_REARM_FRAMES * S2A_HDR_REARM_MAX
+    if (g->step < S2A_HDR_REARM_FRAMES * S2A_HDR_REARM_MAX) g->step *= 2;
+    g->nil_run = 0;
+    g->latched = 0;          // 解除锁存：切回 16F 后由 step() 重新累计 nil 帧
+    return 1;
+}
+
+// 16F 画布稳定工作时调用：把退避复位，下次真的降级时仍从 10 秒开始试探。
+static inline void s2a_hdr_fmt_guard_ok(s2a_hdr_fmt_guard *g) {
+    if (!g || g->latched) return;
+    g->wait = 0;
+    g->step = S2A_HDR_REARM_FRAMES;
+}
+
+// 缺省参数。S2A_HDR_HEADROOM 只读一次并缓存（设置链在起局前写入，运行期由 s2a_hdr_head_set 覆盖）。
+static inline s2a_hdr_itm s2a_hdr_itm_params(void) {
+    static s2a_hdr_itm p;
+    static int done;
+    if (!done) {
+        p.head = 2.0f; p.knee_lo = 0.55f; p.knee_hi = 1.0f;
+        const char *e = getenv("S2A_HDR_HEADROOM");
+        if (e && *e) {
+            char *end = NULL;
+            double v = strtod(e, &end);
+            if (end && end != e && v >= 1.0 && v <= 4.0) p.head = (float)v;
+        }
+        done = 1;
+    }
+    // 注意不能改缓存里的 p：运行期覆盖一旦写进缓存，覆盖撤销后就再也回不到基线
+    //   （实测：2.0 → 覆盖 3.0 → 覆盖 1.0 → 撤销，缓存里留着 1.0）。所以按值返回副本。
+    s2a_hdr_itm r = p;
+    if (s2a_hdr_head_live > 0.0f) r.head = s2a_hdr_head_live;   // 运行期覆盖优先
+    return r;
+}
+
+// 0 = 走原来的 BGRA8 路径（逐字节同旧行为）；1 = RGBA16Float + EDR。
+//   只认明确的 0 / false / no / off（不分大小写）为关；没设也算关——未启用时行为一点不变。
+//   设了空串算开：启动环境显式给了这个变量，意图就是开。
+static inline int s2a_hdr_enabled(const char *env) {
+    if (!env) return 0;
+    if (*env == '0') return 0;
+    if (!strcasecmp(env, "false") || !strcasecmp(env, "no") || !strcasecmp(env, "off")) return 0;
+    return 1;
+}
+
+// 出屏「格式 / EDR 声明」的决策，抽成纯函数：真机三格矩阵全靠它，而这两个开关决定「会不会黑屏」。
+//   S2A_HDR_OUTPUT=1  总开关：16F 画布 + 声明 EDR（T2）
+//   S2A_HDR_FMT=1     只换画布：16F，但不声明 EDR（T1，用来分辨黑屏是格式还是 EDR 造成的）
+//   S2A_HDR_FMT=0     只换声明：仍是 8 位字节，但声明 EDR（T3）
+// 组合语义（旧实现把 FMT=1 当「永远不声明 EDR」，于是 FMT=1 + OUTPUT=1 会悄悄失去 EDR，
+//   而 T2 正是这么写的 —— 矩阵与代码自相矛盾的坑，回归用例在 t_hdr_env）：
+//   FMT=1 + OUTPUT=1 ⇒ 16F + EDR（OUTPUT 是显式打开，诊断开关不该把它关掉）
+//   FMT=0 + OUTPUT=*  ⇒ 8B  + EDR（FMT=0 的意图就是「只声明」）
+//   其它/空串/垃圾值 ⇒ 同未设
+static inline void s2a_hdr_out_plan(int output_on, const char *fmtenv, int *want16, int *want_edr) {
+    const int fmt = (fmtenv && *fmtenv == '1') ? 1 : ((fmtenv && *fmtenv == '0') ? 0 : -1);
+    if (fmt == 1) { *want16 = 1; *want_edr = output_on ? 1 : 0; }
+    else if (fmt == 0) { *want16 = 0; *want_edr = 1; }
+    else { *want16 = output_on ? 1 : 0; *want_edr = output_on ? 1 : 0; }
+}
+
+// sRGB 编码值（0..1）→ 线性。分段式与 IEC 61966-2-1 一致，也是 Metal 采样 sRGB 纹理时的解码曲线。
+static inline float s2a_hdr_to_linear(float c) {
+    // 用 !(c > 0) 而不是 c <= 0：NaN 走这一支会返回 0，否则会一路 powf 到 NaN 传进直方图。
+    if (!(c > 0.0f)) return 0.0f;
+    if (c <= 0.04045f) return c / 12.92f;
+    if (c >= 1.0f) return 1.0f;
+    return powf((c + 0.055f) / 1.055f, 2.4f);
+}
+
+// 线性 -> sRGB 编码值（0..1）。上屏前用，与上一条互逆；两段在 0.0031308 处连续。
+static inline float s2a_hdr_to_srgb(float c) {
+    if (!(c > 0.0f)) return 0.0f;
+    if (c <= 0.0031308f) return c * 12.92f;
+    return 1.055f * powf(c, 1.0f / 2.4f) - 0.055f;
+}
+
+static inline float s2a_hdr_smoothstep(float e0, float e1, float x) {
+    float t = (x - e0) / (e1 - e0);
+    if (t <= 0.0f) return 0.0f;
+    if (t >= 1.0f) return 1.0f;
+    return t * t * (3.0f - 2.0f * t);
+}
+
+// 给一个亮度 y（线性）算扩张倍数。y ≤ knee_lo 恒为 1（中间调不动），y ≥ knee_hi 恒为 head（不外推）。
+static inline float s2a_hdr_itm_gain(const s2a_hdr_itm *p, float y) {
+    if (!p) return 1.0f;
+    // 退化 / 反向的拐点：上屏的 fs 有 `if (!(hi > lo + 1e-5)) return a * head;` 的早退分支，
+    //   那边整帧直接吃满 head。CPU 侧原来没有这条，于是 lo == hi 时 smoothstep 的
+    //   (x-e0)/0 走进 <=0 分支给 gain 1，两侧差整整一个 head（实测 0.214041 vs 0.428082）。
+    //   这里补上同一分支，CPU 与上屏从此一致（t_hdr_shader_mirror 场景二）。
+    if (!(p->knee_hi > p->knee_lo + 1e-5f)) return p->head;
+    return 1.0f + (p->head - 1.0f) * s2a_hdr_smoothstep(p->knee_lo, p->knee_hi, y);
+}
+
+// 三通道（输入是**线性光**）：按 Rec.709 亮度算 gain，再乘回三通道（同一个倍数 → 保色相，不偏色）。
+static inline void s2a_hdr_itm_rgb_lin(const s2a_hdr_itm *p, const float lin[3], float out[3]) {
+    float y = 0.2126f * lin[0] + 0.7152f * lin[1] + 0.0722f * lin[2];
+    float k = s2a_hdr_itm_gain(p, y);
+    out[0] = lin[0] * k; out[1] = lin[1] * k; out[2] = lin[2] * k;
+}
+
+// 同上，但输入是**sRGB 编码值**（0..1）。两套约定并存过一段时间，踩过一次坑：把线性值喂给这个函数
+// 会被再解码一遍，输出小两个数量级。需要线性入口请用 s2a_hdr_itm_rgb_lin。
+static inline void s2a_hdr_itm_rgb(const s2a_hdr_itm *p, const float in[3], float out[3]) {
+    float lin[3];
+    for (int i = 0; i < 3; i++) lin[i] = s2a_hdr_to_linear(in[i]);
+    s2a_hdr_itm_rgb_lin(p, lin, out);
+}
+
+
+// ---------- 另一种放置方式：BT.2408-8 §5.1 的 display-referred SDR→HDR ----------
+// 本模块默认用「纸白以下不动、纸白以上按 smoothstep 抬」的 knee 方案（保留 SDR 的对比观感，
+//   只把高光抬上去）。BT.2408-8 §5.1 给的是另一种官方做法：
+//     1) SDR 峰值白 100 cd/m² 线性放大到 HDR Reference White 203 cd/m²（×2.03，+1.02 stop）；
+//     2) 再做 OOTF gamma 校正 L' = L^1.15（BBC 主观测试；ARIB 为 1.16），
+//        否则中调会显得被冲淡 —— 也就是「白抬 1.02 stop，但中调抬得比白少」。
+//   合起来：L_out = head * L^1.15（head 缺省 2.03）。黑仍映射到 0，白色正好落在 head。
+//   与 knee 方案的实测差异：线性 0.18 中间调 knee ×1.0000 / bt2408 ×1.5696；
+//   线性 0.50 knee ×1.0000（缺省拐点 0.55 之下）/ bt2408 ×1.8295；线性 1.00 knee ×2.0000（head=2）/ bt2408 ×2.0300。
+//   也就是说 bt2408 把整幅按幂函数抬起来（黑仍为 0），knee 只抬纸白以上 —— 两种观感，
+//   不是谁更对：bt2408 更接近「把 SDR 放进 HDR 容器」的官方定义，knee 更接近 RTX HDR
+//   那种「保住 SDR 观感、只把高光顶出去」。
+//   逐通道做 gamma 会改变彩度（三个通道各自幂运算），所以这里按 Rec.709 亮度算比值再乘 RGB，
+//   与 s2a_hdr_itm_rgb 同口径；这是相对文献的自觉偏离，写在 docs/SOURCES.md。
+#ifndef S2A_HDR_BT2408_HEAD
+#define S2A_HDR_BT2408_HEAD 2.03f
+#endif
+#ifndef S2A_HDR_BT2408_GAMMA
+#define S2A_HDR_BT2408_GAMMA 1.15f
+#endif
+
+static inline void s2a_hdr_bt2408_rgb_lin(const float lin[3], float head, float out[3]) {
+    float y = 0.2126f * lin[0] + 0.7152f * lin[1] + 0.0722f * lin[2];
+    float k;
+    if (!(head > 0.0f)) head = S2A_HDR_BT2408_HEAD;
+    if (!(y > 0.0f)) {
+        out[0] = out[1] = out[2] = 0.0f;
+        return;
+    }
+    k = head * powf(y, S2A_HDR_BT2408_GAMMA - 1.0f);   // 相对亮度 y 的等比倍数
+    out[0] = lin[0] * k; out[1] = lin[1] * k; out[2] = lin[2] * k;
+}
+
+// ---------- 色域 / 饱和度（对标 RTX HDR 的 "saturation"，取 BT.2087 的 sRGB→Display P3 矩阵）----------
+// RTX HDR 除了亮度扩张还会把 SDR 的 sRGB 色彩往宽色域推一点，并用一个饱和度旋钮补齐观感；
+//   libplacebo 对应 gamut_expansion / saturation。这里默认全关（sat=1、p3=0），所以缺省包逐字节同以前。
+// 两个旋钮都保持「灰不变」：sRGB→P3 矩阵每行和为 1，饱和度按亮度做中心缩放 → 中性灰在任何组合下都不动。
+#ifndef S2A_HDR_SAT_MIN
+#define S2A_HDR_SAT_MIN 0.5f
+#endif
+#ifndef S2A_HDR_SAT_MAX
+#define S2A_HDR_SAT_MAX 2.0f
+#endif
+
+// S2A_HDR_SAT：颜色饱和度倍数（缺省 1.0，钳 [0.5,2]）。1 = 不动。
+static inline float s2a_hdr_sat(void) {
+    static float v; static int done;
+    if (!done) {
+        v = 1.0f;
+        const char *e = getenv("S2A_HDR_SAT");
+        if (e && *e) {
+            char *end = NULL; double d = strtod(e, &end);
+            if (end && end != e) { if (d < S2A_HDR_SAT_MIN) d = S2A_HDR_SAT_MIN; if (d > S2A_HDR_SAT_MAX) d = S2A_HDR_SAT_MAX; v = (float)d; }
+        }
+        done = 1;
+    }
+    return v;
+}
+// S2A_HDR_P3：往 Display P3 推多少（缺省 0，钳 [0,1]）。0 = 不动，1 = 按 P3 原色解释。
+//   不是「换色域标签」：矩阵只把三原色往宽色域挪一点，白点与灰轴不变。
+static inline float s2a_hdr_p3(void) {
+    static float v; static int done;
+    if (!done) {
+        v = 0.0f;
+        const char *e = getenv("S2A_HDR_P3");
+        if (e && *e) {
+            char *end = NULL; double d = strtod(e, &end);
+            if (end && end != e) { if (d < 0.0) d = 0.0; if (d > 1.0) d = 1.0; v = (float)d; }
+        }
+        done = 1;
+    }
+    return v;
+}
+// 线性光下的 sRGB → Display P3（BT.2087 推导的 3×3；每行和为 1，所以中性灰不变）
+// 原始 BT.2087 数值每行和是 0.9999 / 1.0001 / 1.0000（四舍五入留下 1e-4 的偏差，灰会偏 1e-4 量级）；
+//   这里按行归一化，让「灰不变」变成结构性的而不是靠容差。
+#define S2A_HDR_P3_R0 0.822582f, 0.177418f, 0.000000f
+#define S2A_HDR_P3_R1 0.033197f, 0.966803f, 0.000000f
+#define S2A_HDR_P3_R2 0.017100f, 0.072400f, 0.910500f
+static inline void s2a_hdr_p3_rgb(const float in[3], float mix, float out[3]) {
+    float m[3][3] = {{S2A_HDR_P3_R0}, {S2A_HDR_P3_R1}, {S2A_HDR_P3_R2}};
+    if (mix <= 0.0f) { out[0] = in[0]; out[1] = in[1]; out[2] = in[2]; return; }
+    if (mix > 1.0f) mix = 1.0f;
+    for (int i = 0; i < 3; i++) {
+        float v = m[i][0] * in[0] + m[i][1] * in[1] + m[i][2] * in[2];
+        out[i] = in[i] + (v - in[i]) * mix;
+    }
+}
+// 保亮度的饱和度：以 Rec.709 亮度为中心往外拉。sat=1 恒等；sat>1 更艳，sat<1 更灰；纯灰恒等。
+static inline float s2a_hdr_lab_f(float t) {
+    return t > 0.008856f ? powf(t, 1.0f / 3.0f) : (7.787f * t + 16.0f / 116.0f);
+}
+
+static inline float s2a_hdr_lab_finv(float t) {
+    float t3 = t * t * t;
+    return t3 > 0.008856f ? t3 : (t - 16.0f / 116.0f) / 7.787f;
+}
+
+// S2A_HDR_SAT_SPACE：1 = 在 Lab 里缩放色度（保色相，默认），0 = 线性锚定（旧行为）
+static inline int s2a_hdr_sat_space(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *e = getenv("S2A_HDR_SAT_SPACE");
+        cached = (e && e[0] == '0') ? 0 : 1;
+    }
+    return cached;
+}
+
+// ---- 线性 sRGB ⇄ CIELAB（D65）----
+// 为什么需要它：把饱和度乘在「偏离亮度的量」上（y + (c-y)*s）在 Lab 里不是保色相的，
+// 真实照片 sat=1.6 实测 p99 色相误差 9.9–20.1°、sat=2.0 到 17–30°（Monument 最差）。
+// 直接在 Lab 里乘 a*/b*（等价于在 LCh 里乘 C*）则色相角按构造不变：实测三张照片 0.00°。
+static inline void s2a_hdr_lab_from_lin(const float rgb[3], float lab[3]) {
+    float x = 0.4124564f * rgb[0] + 0.3575761f * rgb[1] + 0.1804375f * rgb[2];
+    float y = 0.2126729f * rgb[0] + 0.7151522f * rgb[1] + 0.0721750f * rgb[2];
+    float z = 0.0193339f * rgb[0] + 0.1191920f * rgb[1] + 0.9503041f * rgb[2];
+    float fx = s2a_hdr_lab_f(x / 0.95047f), fy = s2a_hdr_lab_f(y), fz = s2a_hdr_lab_f(z / 1.08883f);
+    lab[0] = 116.0f * fy - 16.0f;
+    lab[1] = 500.0f * (fx - fy);
+    lab[2] = 200.0f * (fy - fz);
+}
+
+static inline void s2a_hdr_lin_from_lab(const float lab[3], float rgb[3]) {
+    float fy = (lab[0] + 16.0f) / 116.0f;
+    float fx = fy + lab[1] / 500.0f, fz = fy - lab[2] / 200.0f;
+    float x = 0.95047f * s2a_hdr_lab_finv(fx);
+    float y = s2a_hdr_lab_finv(fy);
+    float z = 1.08883f * s2a_hdr_lab_finv(fz);
+    rgb[0] = 3.2404542f * x - 1.5371385f * y - 0.4985314f * z;
+    rgb[1] = -0.9692660f * x + 1.8760108f * y + 0.0415560f * z;
+    rgb[2] = 0.0556434f * x - 0.2040259f * y + 1.0572252f * z;
+}
+
+static inline float s2a_hdr_sat_scale_min(const float lab[3], float s) {
+    float t[3] = {lab[0], lab[1] * s, lab[2] * s}, rgb[3];
+    s2a_hdr_lin_from_lab(t, rgb);
+    return rgb[0] < rgb[1] ? (rgb[0] < rgb[2] ? rgb[0] : rgb[2])
+                           : (rgb[1] < rgb[2] ? rgb[1] : rgb[2]);
+}
+
+// 保色相饱和度：在 Lab 里缩放 a*/b*；穿出线性 RGB 负区时二分退回最大的安全倍数。
+static inline void s2a_hdr_sat_lab_rgb(const float in[3], float sat, float out[3]) {
+    float lab[3];
+    s2a_hdr_lab_from_lin(in, lab);
+    // 中性色（含灰、白、黑）在 Lab 里 a*=b*=0，缩放没有意义，而往返换算有 ~1e-4 的
+    // float 误差 —— 直接短路，保证「灰恒为灰」是逐位性质而不是近似性质。
+    if (lab[1] > -1e-3f && lab[1] < 1e-3f && lab[2] > -1e-3f && lab[2] < 1e-3f) {
+        out[0] = in[0]; out[1] = in[1]; out[2] = in[2];
+        return;
+    }
+    float s = sat;
+    if (s2a_hdr_sat_scale_min(lab, s) < 0.0f) {
+        float lo = 1.0f, hi = s;                     // lo 一定安全（原色本身可显示）
+        for (int i = 0; i < 14; i++) {
+            float mid = 0.5f * (lo + hi);
+            if (s2a_hdr_sat_scale_min(lab, mid) >= 0.0f) lo = mid; else hi = mid;
+        }
+        s = lo;
+    }
+    float t[3] = {lab[0], lab[1] * s, lab[2] * s};
+    s2a_hdr_lin_from_lab(t, out);
+    for (int i = 0; i < 3; i++) if (out[i] < 0.0f) out[i] = 0.0f;
+}
+
+static inline void s2a_hdr_sat_rgb(const float in[3], float sat, float out[3]) {
+    if (sat == 1.0f) { out[0] = in[0]; out[1] = in[1]; out[2] = in[2]; return; }   // 缺省路径逐位不变
+    if (s2a_hdr_sat_space() == 1) { s2a_hdr_sat_lab_rgb(in, sat, out); return; }
+    float y = 0.2126f * in[0] + 0.7152f * in[1] + 0.0722f * in[2];
+    float dmin = 0.0f;
+    for (int i = 0; i < 3; i++) { float d = in[i] - y; if (d < dmin) dmin = d; }
+    float ss = sat;
+    if (dmin < 0.0f && y > 0.0f) { float smax = y / -dmin; if (smax < ss) ss = smax; }
+    out[0] = y + (in[0] - y) * ss;
+    out[1] = y + (in[1] - y) * ss;
+    out[2] = y + (in[2] - y) * ss;
+    for (int i = 0; i < 3; i++) if (out[i] < 0.0f) out[i] = 0.0f;   // 只夹负侧：>1 的高光是 HDR 要保留的东西
+}
+// 完整链路（线性光）：色域 → 饱和度 → ITM。与 MSL 的 16F 分支同序同常数。
+// 调色后可能超上界：Display P3 混色与饱和度缩放都会把某个通道推高（实测 sat=3.0 时
+// 蓝通道可到 head+2.05）。EDR 画布超过上界的部分由系统**直接钳**，那会切出色块和色相偏移——
+// 正是保持色相的努力要避免的东西。这里改成等比缩放：整条三元组乘 head/m，只降亮度、不动色相。
+static inline void s2a_hdr_clip_head(const float in[3], float head, float out[3]) {
+    if (!(head > 0.0f)) head = 1.0f;
+    float m = in[0] > in[1] ? in[0] : in[1];
+    if (in[2] > m) m = in[2];
+    float k = (m > head) ? head / m : 1.0f;
+    for (int i = 0; i < 3; i++) {
+        float v = in[i] * k;
+        out[i] = v > 0.0f ? v : 0.0f;
+    }
+}
+
+static inline void s2a_hdr_grade_rgb(const s2a_hdr_itm *p, float sat, float p3, const float lin_in[3], float out[3]) {
+    if (sat == 1.0f && p3 <= 0.0f) {   // 两个旋钮都没动：直接走 ITM，逐位等同 s2a_hdr_itm_rgb
+        float y0 = 0.2126f * lin_in[0] + 0.7152f * lin_in[1] + 0.0722f * lin_in[2];
+        float k0 = s2a_hdr_itm_gain(p, y0);
+        out[0] = lin_in[0] * k0; out[1] = lin_in[1] * k0; out[2] = lin_in[2] * k0;
+        return;
+    }
+    float a[3];
+    s2a_hdr_p3_rgb(lin_in, p3, a);
+    s2a_hdr_sat_rgb(a, sat, a);
+    float y = 0.2126f * a[0] + 0.7152f * a[1] + 0.0722f * a[2];
+    float k = s2a_hdr_itm_gain(p, y);
+    float g[3] = {a[0] * k, a[1] * k, a[2] * k};
+    s2a_hdr_clip_head(g, p->head, out);
+}
+
+// ---------- 内容映射（RTX HDR 那一路）：把整个 SDR 画面放进 HDR 容器 ----------
+// 上面两种放置方式以前只有 hdr_convert（工具）能选，设备上永远是 knee 方案。于是「开了 HDR 之后
+// 画面几乎没变」是必然的：纸白定在 99.5 分位 ⇒ 99% 以上像素落在拐点之下（docs/FIDELITY.md 实测
+// 码值有变化的像素只有 0.02%–0.41%）。游戏内容没有系统 UI 要保护，用户想要的是整体抬起来。
+//
+// 所以把选择权交给设备：S2A_HDR_MAP=1 → bt2408（L_out = head * L^1.15，黑仍 0、白正好落 head）。
+// 缺省 0 保持 knee，逐字节同以前（缺省包与上游的差异仍只有「有没有画 16F」这一条）。
+#ifndef S2A_HDR_MAP_DEFAULT
+#define S2A_HDR_MAP_DEFAULT 0
+#endif
+
+// 纯函数版本的解析（单测直接喂字符串，不必 setenv + 静态缓存）
+static inline int s2a_hdr_map_parse(const char *e) {
+    // 只认显式的 1 / bt2408 / content；其它（空、0、knee、拼错）一律回缺省，
+    //   因为这一档会把纸白以下一起抬起来，拼错一个字就整幅变样。
+    if (!e) return S2A_HDR_MAP_DEFAULT;
+    if (e[0] == '1' || !strncmp(e, "bt2408", 6) || !strncmp(e, "content", 7)) return 1;
+    return S2A_HDR_MAP_DEFAULT;
+}
+
+static inline int s2a_hdr_map(void) {
+    static int v = -1;
+    if (v < 0) v = s2a_hdr_map_parse(getenv("S2A_HDR_MAP"));
+    return v;
+}
+
+// map: 0 = knee（缺省） 1 = BT.2408 内容映射。两路的色域/饱和度顺序一致（p3 → sat → 亮度映射），
+// 只有「乘多少」不同：knee 走 smoothstep 拐点，bt2408 走 head * y^(gamma-1)。
+static inline void s2a_hdr_grade_rgb_map(const s2a_hdr_itm *p, float sat, float p3, int map,
+                                         const float lin_in[3], float out[3]) {
+    if (map != 1) { s2a_hdr_grade_rgb(p, sat, p3, lin_in, out); return; }
+    float a[3];
+    if (sat == 1.0f && p3 <= 0.0f) { a[0] = lin_in[0]; a[1] = lin_in[1]; a[2] = lin_in[2]; }
+    else {
+        s2a_hdr_p3_rgb(lin_in, p3, a);
+        s2a_hdr_sat_rgb(a, sat, a);
+    }
+    float y = 0.2126f * a[0] + 0.7152f * a[1] + 0.0722f * a[2];
+    float head = (p && p->head > 0.0f) ? p->head : S2A_HDR_BT2408_HEAD;
+    float k = (y > 0.0f) ? head * powf(y, S2A_HDR_BT2408_GAMMA - 1.0f) : 0.0f;
+    float g[3] = {a[0] * k, a[1] * k, a[2] * k};
+    s2a_hdr_clip_head(g, head, out);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+
+// —— knee 的发布/消费 ——
+// 写入方是 Metal 完成回调（后台队列，hdr_hist_tick 里每 8 帧一次），读取方是渲染线程每帧。
+// 拆成两个 float 写会有撕裂窗口：lo 已更新、delta 还是旧的 ⇒ hi = lo + delta 算出来可能 < lo，
+// 该帧不是「不扩张」而是「反向压缩」，画面会闪一下（而且只在负载抖动时偶发，日志里看不到）。
+// 打包进一个 64 位再原子发布，读方一次拿到自洽的 (lo, delta)。
+// 打包用 float 的位模式（不变量：delta >= 0 由调用方保证），release/acquire 保证渲染线程
+// 不会读到「新 lo + 旧 delta」这种跨帧组合。
+static inline unsigned long long s2a_hdr_knee_pack(float lo, float delta) {
+    unsigned int a = 0u, b = 0u;
+    memcpy(&a, &lo, sizeof a);
+    memcpy(&b, &delta, sizeof b);
+    return ((unsigned long long)a << 32) | (unsigned long long)b;
+}
+
+static inline void s2a_hdr_knee_unpack(unsigned long long v, float *lo, float *delta) {
+    unsigned int a = (unsigned int)(v >> 32), b = (unsigned int)(v & 0xffffffffull);
+    if (lo) memcpy(lo, &a, sizeof a);
+    if (delta) memcpy(delta, &b, sizeof b);
+}
+
+static inline void s2a_hdr_knee_publish(unsigned long long *slot, float lo, float delta) {
+    if (!slot) return;
+    if (!(delta >= 0.0f)) delta = 0.0f;      // 反向 knee 不上屏（打包不变量）
+    __atomic_store_n(slot, s2a_hdr_knee_pack(lo, delta), __ATOMIC_RELEASE);
+}
+
+// 返回 1 表示拿到已发布过的值；0 表示从未发布（调用方用自己的缺省 0.55/0.45）
+static inline int s2a_hdr_knee_take(const unsigned long long *slot, float *lo, float *delta) {
+    if (!slot) return 0;
+    unsigned long long v = __atomic_load_n(slot, __ATOMIC_ACQUIRE);
+    if (v == 0ull) return 0;
+    s2a_hdr_knee_unpack(v, lo, delta);
+    return 1;
+}
+
+
+
+// ---- 诊断行（S2A_HDR_LOG=1）--------------------------------------------------------------
+// HDR 是「看不见」的功能：用户没法从画面上判断它到底有没有生效，真机三格矩阵（T1/T2/T3）也只能靠日志判。
+// 这一行的格式固定、字段名固定、小数位固定，好让 grep/awk 与人工比对都不出错：
+//   HDR stat: fmt=16F head=2.00 knee=0.3400+0.6600 white=0.7900 avg=-1.20 scene=0.00 frozen=0 itm=1 map=0
+// map 是放置方式（0 = 拐点，1 = BT.2408 内容映射）。它**不在** itm 里：itm 只回答「有没有走扩张」，
+//   而 map=1 时 knee 整套不参与运算（只作日志），这两件事混在一个字段里，reviewer 一定先问
+//   「knee 明明打印了 0.34 为什么画面是整幅亮的」——所以单独打。旧日志没有这个字段也能解析（缺省 0）。
+// fmt 打的是**当前画布**（16F/8B），itm 打的是上屏是否真的走扩张（8 位画布恒 0）——
+// 这两个字段分开打，是因为「格式换过但 shader 没换」正好是降级时最容易搞错的一步。
+#define S2A_HDR_LOG_EVERY 600   // 600 帧 ≈10 秒 @60 Hz
+
+typedef struct {
+    int   fmt16;      // 1 = 画布是 RGBA16Float
+    int   itm;        // 1 = 上屏走 ITM 扩张
+    int   frozen;     // 1 = 本帧被判为淡出/暗场，拐点保持
+    int   map;        // 0 = 拐点方案, 1 = BT.2408 内容映射（knee 不参与）
+    float head, knee_lo, knee_hi, white, avg, scene;
+} s2a_hdr_stat;
+
+// 返回 snprintf 的「若缓冲足够大会写多少」（>n-1 表示被截断）。
+static inline int s2a_hdr_status_line(char *buf, size_t n, const s2a_hdr_stat *st) {
+    if (!buf || n == 0) return 0;
+    if (!st) { return snprintf(buf, n, "HDR stat: (none)"); }
+    char avg[32];
+    if (isfinite(st->avg)) snprintf(avg, sizeof avg, "%.2f", (double)st->avg);
+    else snprintf(avg, sizeof avg, "n/a");       // 首帧 / 空直方图：不要打 nan/-inf 去污染日志
+    char scene[16];
+    if (isfinite(st->scene)) snprintf(scene, sizeof scene, "%.2f", (double)st->scene);
+    else snprintf(scene, sizeof scene, "n/a");
+    return snprintf(buf, n,
+                    "HDR stat: fmt=%s head=%.2f knee=%.4f+%.4f white=%.4f avg=%s scene=%s frozen=%d itm=%d map=%d",
+                    st->fmt16 ? "16F" : "8B", (double)st->head,
+                    (double)st->knee_lo, (double)(st->knee_hi - st->knee_lo),
+                    (double)st->white, avg, scene, st->frozen ? 1 : 0, st->itm ? 1 : 0,
+                    st->map ? 1 : 0);
+}
+
+#endif
diff --git a/graphics/nvn/gfx/nvn/nvn_hdr_auto.h b/graphics/nvn/gfx/nvn/nvn_hdr_auto.h
new file mode 100644
index 00000000..45557a30
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_hdr_auto.h
@@ -0,0 +1,90 @@
+// HDR 出屏的自适应参数（L0）：从一帧的亮度分布决定 knee 往哪挪，而不是所有场景共用 0.55:1.0。
+//
+// 为什么需要：固定 knee 在暗场景下等于不扩张——SDR 画面最亮也就到 1.0 附近，knee_hi=1.0 意味着
+//   只有纯白吃满 headroom，整体偏暗的一局几乎没有 HDR 观感。让 99.5 分位落在「可用上沿 0.8」处，
+//   暗场景的 knee 自动左移，扩张才真的发生在画面里。
+//
+// 分工：这个头文件只做**参数**（纯 C，Linux 单测）；直方图统计与采样在 MSL 里跑，全留 GPU 上，
+//   不回读。present fragment shader 从那三个常量改成读 constant buffer，曲线形式不变。
+//
+// 时间稳定性：单帧最优会闪（RTX HDR 论文把亮度跳变列为显式设计目标）。两件套压住——
+//   一阶平滑（60fps 约 200ms 常数）+ 死区（小于 2% 的变化直接不动）。
+#ifndef S2A_NVN_HDR_AUTO_H
+#define S2A_NVN_HDR_AUTO_H
+#include <math.h>
+#include <stdint.h>
+
+// 直方图格数：256 格覆盖 14 个 stop（每格 0.0547 stop），1 KB，一次 copyFromBuffer 全取回
+#define S2A_HDR_HIST_BINS 256
+#define S2A_HDR_HIST_LO (-10.0f)   // log2 线性亮度下界（0.001）
+#define S2A_HDR_HIST_HI (4.0f)     // log2 线性亮度上界（16）
+#define S2A_HDR_KNEE_RATIO 0.55f   // knee_lo : knee_hi，与原来写死的 0.55:1.0 同一比例
+// 拐点下界的合法区间：低于 0.25 连 SDR 中调都会被抬（UI 发灰），高于 1.0 等于不扩张
+#define S2A_HDR_KNEE_MIN 0.25f
+#define S2A_HDR_KNEE_MAX 1.0f
+#define S2A_HDR_QUANTILE 0.995f    // 让最亮 0.5% 去吃满 headroom（文档用；实际按下面的千分整数算）
+#define S2A_HDR_QUANTILE_PERMILLE 995u  // 分位阈值的唯一真相源：整数千分，GPU/CPU 都用它
+/* 为什么不用 (double)total * 0.995 也不 (float)total * 0.995f：
+   1..8,300,000 个像素总数里有 1,515,878 个会算出不同的阈值（float 版少 1），
+   于是同一帧在 GPU 与 CPU 上可能落在相邻 bin，hi 差一格 = 0.0547 stop。
+   整数千分在两边都精确，见 t_hdr_knee_mirror。 */
+#define S2A_HDR_KNEE_TARGET 0.8f   // 99.5 分位落在「可用上沿」的哪里
+#define S2A_HDR_SMOOTH 0.1f        // 一阶平滑系数
+// 死区（stop）：小于 2% 的变化直接不动，防止内容微动导致每帧方向翻转
+#define S2A_HDR_DEADBAND 0.02f
+/* GPU 直方图的采样间隔（帧）。30 帧一次要从 1.0 走到 0.25 要 17.5 秒，太慢；
+   8 帧一次是 4.7 秒，且 kernel 只占 0.1–0.3ms，摊到每帧 0.02–0.04ms。 */
+#define S2A_HDR_HIST_EVERY 8
+
+// 线性亮度 -> 直方图 bin。0 / 负数 / NaN 一律进最暗一格（不该出现，但别让它越界）。
+static inline int s2a_hdr_hist_bin(float y) {
+    if (!(y > 0.0f)) return 0;                              // 黑 / 负数 / NaN / -inf
+    // +inf 单独处理：原来直接走下面的 (int)f，而 (int)inf 是未定义行为（x86 上得 INT_MIN，
+    // 于是 inf 被夹成 0 号格 = 当黑）。MSL 那边 clamp 到 0.9999999 得 255 号格，
+    // 两边不一致，且 CPU 侧是 UB。现在统一按「最亮」处理，见 t_hdr_bin_mirror 场景四。
+    if (!isfinite(y)) return S2A_HDR_HIST_BINS - 1;
+    float f = (log2f(y) - S2A_HDR_HIST_LO) * ((float)S2A_HDR_HIST_BINS / (S2A_HDR_HIST_HI - S2A_HDR_HIST_LO));
+    int b = (int)f;
+    if (b < 0) b = 0;
+    if (b >= S2A_HDR_HIST_BINS) b = S2A_HDR_HIST_BINS - 1;
+    return b;
+}
+
+// bin 的上界（取「累计到这里就够」的那一格的上沿，宁可多算一点亮度，别把高光算丢）
+static inline float s2a_hdr_hist_edge(int bin) {
+    if (bin < 0) bin = 0;
+    if (bin >= S2A_HDR_HIST_BINS) bin = S2A_HDR_HIST_BINS - 1;
+    return powf(2.0f, S2A_HDR_HIST_LO + (float)(bin + 1) * ((S2A_HDR_HIST_HI - S2A_HDR_HIST_LO) / (float)S2A_HDR_HIST_BINS));
+}
+
+// 从直方图算目标 knee。返回 0 = 直方图全空（调用方保持上一帧），1 = 算出来了。
+static inline int s2a_hdr_auto_knee(const uint32_t hist[S2A_HDR_HIST_BINS], float *hi, float *lo) {
+    uint64_t total = 0;
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) total += hist[i];
+    if (!total) return 0;
+    uint64_t want = (total * S2A_HDR_QUANTILE_PERMILLE) / 1000u;
+    if (want < 1) want = 1;
+    uint64_t acc = 0;
+    int bin = S2A_HDR_HIST_BINS - 1;
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) {
+        acc += hist[i];
+        if (acc >= want) { bin = i; break; }
+    }
+    float y = s2a_hdr_hist_edge(bin);
+    float h = y / S2A_HDR_KNEE_TARGET;
+    if (!(h >= S2A_HDR_KNEE_MIN)) h = S2A_HDR_KNEE_MIN;   // 也兜住 NaN
+    if (h > S2A_HDR_KNEE_MAX) h = S2A_HDR_KNEE_MAX;
+    *hi = h;
+    *lo = S2A_HDR_KNEE_RATIO * h;
+    return 1;
+}
+
+// 一阶平滑 + 死区。prev 是上一帧真正用的 knee_hi。
+static inline float s2a_hdr_auto_step(float prev_hi, float target_hi) {
+    float d = target_hi - prev_hi;
+    if (d < 0) d = -d;
+    if (d < S2A_HDR_DEADBAND) return prev_hi;
+    return prev_hi + (target_hi - prev_hi) * S2A_HDR_SMOOTH;
+}
+
+#endif
diff --git a/graphics/nvn/gfx/nvn/nvn_hdr_auto_l1.h b/graphics/nvn/gfx/nvn/nvn_hdr_auto_l1.h
new file mode 100644
index 00000000..307ee9c7
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_hdr_auto_l1.h
@@ -0,0 +1,549 @@
+// 自动 HDR 的 L1：在 L0（99.5 分位 → knee）之上补三件事，让它接近「RTX HDR / Auto HDR」这类
+// 逐场景自动 SDR→HDR 的行为，而不是全片一个固定 knee。
+//
+// L1 补的三件事（每件都对应业界实现里的一个具体旋钮，见 docs/SOURCES.md）：
+//   1) **漫反射白点**（diffuse / paper white）：SDR 画面里"白"不是一个像素，而是一片面积。
+//      UI、字幕、天空、雪地都是大面积高值；而爆炸、太阳只是极少数像素。
+//      L0 只看 99.5 分位，一颗太阳就能把 knee 顶到 1.0，整幅偏暗的夜景因此没 HDR 感。
+//      L1 取「计数 ≥ 0.5% 总像素的最高一格」当白点，扩张从白点之上才开始。
+//   2) **黑场截断**（black cutoff）：黑边、纯黑背景会污染低端分布，让 percentile 计算偏向暗。
+//      低于阈值（缺省 -6 stops ≈ 0.0156 线性）的像素不计入分位统计。
+//   3) **场景切换**（scene change）：一阶平滑在硬切镜头时会拖出 4~8 秒的"慢慢变亮"。
+//      用直方图的 log2 加权重心判断场景差，差得越大越少平滑，超过上阈值直接跳过去。
+//      这与 libplacebo 的 peak_smoothing_period + scene_threshold_low/high 是同一套思路。
+//
+// 仍然是纯 C、无平台依赖，Linux 上可直接跑 t_hdr_auto_l1。
+#ifndef S2A_NVN_HDR_AUTO_L1_H
+#define S2A_NVN_HDR_AUTO_L1_H
+
+// SDR 编码域的线性上沿（L1b 用它当 knee_hi：白点之上到裁切点之间拿满 head）
+#ifndef S2A_HDR_SDR_CLIP
+#define S2A_HDR_SDR_CLIP 1.0f
+#endif
+// 截断之上的像素少于这个占比就算「黑底画面」：此时白点不可信（星星/孤灯就是唯一亮点）
+#ifndef S2A_HDR_DARK_FRAC
+#define S2A_HDR_DARK_FRAC 0.05f
+#endif
+// 黑底画面从这条线开始扩张（线性亮度，≈ -5.6 stops）
+#ifndef S2A_HDR_DARK_WHITE
+#define S2A_HDR_DARK_WHITE 0.02f    // 白点低于此值当黑底画面（lit_frac 的代理判据）
+#endif
+#ifndef S2A_HDR_DARK_FLOOR
+#define S2A_HDR_DARK_FLOOR 0.02f    // 黑底画面从这条线开始扩张（线性亮度，≈ -5.6 stops）
+#endif
+// 淡出（fade to black）与暗场的区分。
+// 淡到黑时整幅画面等比变暗：白点跟着掉 ⇒ lo 被拖低 ⇒ 中调增益反而越涨
+//（实测 270 帧转场序列：淡出 30 帧里 0.50 线性增益从 ×1.000 涨到 ×1.46，
+// 即「越淡越亮」，观众看到的是淡出过程被抵消 + 中调抽动）。
+// 判据：平均亮度已进暗区（avg < DIM_APL）**且**这一帧还在明显下降（>FADE_SLOPE stop/帧）⇒ 判为淡出，
+// 整帧冻结（白点与两端都不动）——淡出期间没有可信的「纸白」可言，保持不动才是对的。
+// 反向（离开暗区）不冻结，而是当切镜处理（scene=1）：否则从黑回来要爬 30 帧，
+// 期间中调一直被 ×1.4 抬着，表现为「回到画面先闪一下亮」。
+#ifndef S2A_HDR_DIM_APL
+#define S2A_HDR_DIM_APL (-4.5f)
+#endif
+// 淡出的判据用「下降速度窗口」而不是「亮度水平」：
+//   太慢（< FADE_MIN_S）是同场景微动，正常平滑；
+//   太快（> FADE_MAX_S）是硬切到暗场景，必须让拐点跟过去（否则切镜后整段都错）。
+// **单位是 stop/秒，不是 stop/帧**：同一段淡出在 30/60/120 Hz 下每帧的落差差 2/4 倍，
+//   按帧写常数会让判据在 120 Hz 上整体失效（1 秒淡 4 stop 在 120 Hz 只有 0.033/帧，
+//   落在 0.05 之下就完全不冻结，淡出时中调增益照样越黑越涨）。S2Arm 有 30/60/120 三档，
+//   所以判据必须与帧率无关：实测 300 帧序列里交叉淡入 1.6–3.1 stop/s、淡入 3.0–4.1 stop/s、
+//   单帧硬切 0.66 stop@30fps = 19.8 stop/s（必须判成切镜，不能冻）。
+#ifndef S2A_HDR_FADE_MIN_S
+#define S2A_HDR_FADE_MIN_S 1.5f
+#endif
+#ifndef S2A_HDR_FADE_MAX_S
+#define S2A_HDR_FADE_MAX_S 16.0f
+#endif
+#include <math.h>
+#include <stdint.h>
+#include "nvn_hdr_auto.h"   // L0 的直方图定义与常数
+
+// 漫反射白点：一格至少要占这么多像素才算"一片白"，单像素高光不算。
+/* L1 的 knee 上界比 L0 宽：白点可能在 1.0（满屏 UI 白），此时 knee_hi = 1.0/0.8 = 1.25，
+   意思是「画面里没有可扩张的高光了」。若沿用 L0 的 1.0 上限，满屏白会被整体乘 2 直接过曝。 */
+#define S2A_HDR_KNEE_L1_MAX 2.0f
+/* L1 的下界也比 L0 低：白点可能在 0.03（夜景、太空、恐怖游戏），此时 knee 若还钳在 0.25，
+   整帧都落在 knee_lo 以下，扩张等于没开。下界只防 knee 塌到 0（0.01 ≈ 1% 线性亮度，
+   比任何可见内容都暗），不参与观感取舍。 */
+// 白点死区。直方图按 log2 分格（S2A_HDR_HIST_BINS=256 覆盖 -10..+4 ⇒ 每格 0.0547 stop），
+// 内容微动会让测出的白点在**相邻两格**之间来回跳，knee_lo 就被拽着来回走
+//（实测真实照片慢推序列 11 次方向翻转，幅度 0.7%）。死区取 1.5 格：刚好盖住一个格子的
+// 量化跳变，又远小于切镜判据（0.5 stop），真实切换不受影响。
+#define S2A_HDR_HIST_BIN_STOP ((S2A_HDR_HIST_HI - S2A_HDR_HIST_LO) / (float)S2A_HDR_HIST_BINS)
+#define S2A_HDR_WHITE_DEADBAND (1.5f * S2A_HDR_HIST_BIN_STOP)
+
+#define S2A_HDR_KNEE_L1_MIN 0.01f
+#ifndef S2A_HDR_CLUSTER_MAX_FRAC
+#define S2A_HDR_CLUSTER_MAX_FRAC 0.05   // 一簇亮像素少于亮像素的 5% 视为 HUD/孤立高光
+#endif
+#ifndef S2A_HDR_CLUSTER_GAP
+#define S2A_HDR_CLUSTER_GAP 3          // 连续 3 个空 bin（约 0.35 stop）才算分开
+#endif
+// 纸白的定义位置：从最亮格往下累计到总像素的 0.5% 为止，那一格之上就是「高光」。
+// 这个数是「激进程度」的总开关——调大它 = 纸白下沉 = 更多像素吃增益（代价见 docs/FIDELITY.md：
+// 满屏 UI 白也会被抬起来，那是用户最容易察觉的错）。可用 -D 覆盖，方便对账时换档不必改头文件。
+#ifndef S2A_HDR_WHITE_FRAC
+#define S2A_HDR_WHITE_FRAC 0.005f
+#endif
+// 黑场截断：log2 线性亮度低于此值的格子不计入统计（-6 stops = 0.0156）。
+#define S2A_HDR_BLACK_CUT (-6.0f)
+// 重心的黑场门限：比 BLACK_CUT 更低，只排「真黑」（线性 0.0014 ≈ 8 位码 10/255 之下的死区）。
+// 用 -6 会把星空/暗场整片排掉（那些内容常在 0.002..0.01），重心就永远算不出来。
+#define S2A_HDR_AVG_CUT   (-9.5f)
+// 场景切换：低于 LOW 档完全按平滑走，高于 HIGH 档直接跳（单位 = log2 亮度差）。
+// 0.40 / 1.10 是扫出来的：0.66 stop 的「中等切镜」（菜单暗 → 游戏亮这种最常见的量级）
+//   在旧 0.5/1.6 下只拿到 5.5% 权重，要 24 帧才走完 95%（300 帧序列里 B 段肉眼可见地爬）；
+//   改 0.40/1.10 后权重 31.6%、8 帧到位。下限不能低于 0.35：0.30 stop/帧 的快摇镜必须
+//   仍然拿到 0 权重（否则整段画面每帧都在跳），这条有 ref_check 场景十三守着。
+#define S2A_HDR_SCENE_LOW 0.40f
+#define S2A_HDR_SCENE_HIGH 1.10f
+
+// 直方图的 log2 加权重心（场景亮度）。空直方图返回 0 并写 *ok=0。
+static inline int s2a_hdr_bin_black(int bin) {
+    float y = S2A_HDR_HIST_LO + (float)bin * ((S2A_HDR_HIST_HI - S2A_HDR_HIST_LO) / (float)S2A_HDR_HIST_BINS);
+    return y < S2A_HDR_BLACK_CUT;
+}
+
+static inline float s2a_hdr_hist_avg(const uint32_t hist[S2A_HDR_HIST_BINS], int *ok) {
+    uint64_t total = 0;
+    double acc = 0.0;
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) {
+        uint64_t c = hist[i];
+        if (!c) continue;
+        // 只排除真正的黑（bin 下沿 < -9.5，即线性 0.0014 以下），不排 -6 以下的暗部。
+        // 口径必须与 MSL 的 hdr_hist_l1 完全一致：这条差异是 t_hdr_gpu_mirror 抓出来的
+        // （同一份带黑边直方图：CPU 把重心算到 -4.7120，GPU 是 -1.2049，差 3.5 stop）。
+        // 而门槛只降到「真黑」而不是 -6：星空的星点常在 0.002..0.01，按 -6 会被整片丢掉。
+        if (S2A_HDR_HIST_LO + (float)i * ((S2A_HDR_HIST_HI - S2A_HDR_HIST_LO) / (float)S2A_HDR_HIST_BINS)
+            < S2A_HDR_AVG_CUT) continue;
+        // 用格子中心当代表值（不是上沿）：重心要的是期望，不是上界
+        double y = (double)S2A_HDR_HIST_LO + ((double)i + 0.5) * ((double)(S2A_HDR_HIST_HI - S2A_HDR_HIST_LO) / (double)S2A_HDR_HIST_BINS);
+        acc += y * (double)c;
+        total += c;
+    }
+    if (ok) *ok = total != 0;
+    return total ? (float)(acc / (double)total) : 0.0f;
+}
+
+// 低于黑场截断的格子视作 0 像素（原地不改调用方的数组，用一份阈值判断）。
+
+// 漫反射白点：从亮往暗扫，第一个「计数 ≥ total*WHITE_FRAC」的格子；找不到返回 0。
+static inline int s2a_hdr_sdr_white(const uint32_t hist[S2A_HDR_HIST_BINS], float *white) {
+    uint64_t total = 0;
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) if (!s2a_hdr_bin_black(i)) total += hist[i];
+    if (!total) return 0;
+    uint64_t need = (uint64_t)((double)total * (double)S2A_HDR_WHITE_FRAC);
+    if (need < 1) need = 1;
+    for (int i = S2A_HDR_HIST_BINS - 1; i >= 0; i--) {
+        if (s2a_hdr_bin_black(i)) break;
+        if ((uint64_t)hist[i] >= need) { *white = s2a_hdr_hist_edge(i); return 1; }
+    }
+    return 0;
+}
+
+// 白点估计的「HUD / 高光孤立簇」剔除。
+//   动机：静态 HUD 白字、准星、字幕通常只占 1% 左右的像素却坐在 0.8 以上的高位。
+//   纯白点算法会把整帧的纸白顶到 HUD 亮度上，于是 100% 的内容都不再扩张。
+//   做法：从高往低扫「非空 bin 的连续簇」；如果最高那一簇的质量 < S2A_HDR_CLUSTER_MAX_FRAC，
+//   且它与下方主簇之间隔着 >= S2A_HDR_CLUSTER_GAP 个空 bin，就判它是 HUD/孤立高光，丢掉它，
+//   用下方主簇的顶边当白点。真实的高亮内容（天空、白墙）与主簇相连，不会被误丢。
+// 可调参数版本：给敏感度扫描用（结论应证明默认常数坐在平台区，而不是刀刃上）。
+static inline int s2a_hdr_sdr_white_bulk_opt(const uint32_t hist[S2A_HDR_HIST_BINS], double max_frac,
+                                             int gap_bins, float *white) {
+    uint64_t total = 0;
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) if (!s2a_hdr_bin_black(i)) total += hist[i];
+    if (!total) return 0;
+
+    // 从最高非黑 bin 往下走，按「空 bin」切簇
+    int i = S2A_HDR_HIST_BINS - 1;
+    while (i >= 0 && (s2a_hdr_bin_black(i) || hist[i] == 0)) i--;
+    while (i >= 0) {
+        int top = i;
+        uint64_t mass = 0;
+        int gap = 0;
+        while (i >= 0) {
+            if (s2a_hdr_bin_black(i) || hist[i] == 0) {
+                if (++gap >= gap_bins) break;   // 够深的空档 → 簇结束
+            } else {
+                gap = 0;
+                mass += hist[i];
+            }
+            i--;
+        }
+        // 这一簇够重（≥ 5% 亮像素）就是主簇：白点仍按「主簇内部的 0.5% 分位」取，
+        // 而不是直接取簇顶。取簇顶会在自然照片上把纸白抬得过高（实测大块天空/雪地
+        // 抬高 0.3–0.8 stop，扩张被无谓削弱），因为主簇本身能占到 5%–40% 的像素。
+        // 分位只算主簇（即 top 以下、被丢掉的那些孤立簇不参与），这样：
+        //   · HUD 场景：孤立 HUD 簇被丢，分位落在内容白点上（0.2381）✔
+        //   · 自然照片：主簇完整，分位≈普通白点（0.5278 / 0.3898 / 0.6626）✔
+        if ((double)mass >= (double)total * max_frac) {
+            // 主簇内部仍用与 s2a_hdr_sdr_white 完全相同的判据（「最高一个计数 ≥ 0.5% 的格」），
+            // 只是把被丢掉的孤立簇排除在扫描范围外。这样「没有孤立簇」时两者逐位相同，
+            // 有 HUD 时白点落在内容白点上，而不是簇顶（簇顶会在自然照片上把纸白抬高 0.3–0.8 stop）。
+            uint64_t need = (uint64_t)((double)total * (double)S2A_HDR_WHITE_FRAC);
+            if (need < 1) need = 1;
+            for (int k = top; k >= 0; k--) {
+                if (s2a_hdr_bin_black(k)) break;
+                if ((uint64_t)hist[k] >= need) { *white = s2a_hdr_hist_edge(k); return 1; }
+            }
+            *white = s2a_hdr_hist_edge(top);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static inline int s2a_hdr_sdr_white_bulk(const uint32_t hist[S2A_HDR_HIST_BINS], float *white) {
+    return s2a_hdr_sdr_white_bulk_opt(hist, (double)S2A_HDR_CLUSTER_MAX_FRAC, S2A_HDR_CLUSTER_GAP, white);
+}
+
+// 截断之上的像素占比：黑底画面（星空、纯黑过场）里这个值很小，白点估计会退化成「星星就是白」，
+//   这时应该按「暗场景」处理（从近黑开始扩张），而不是把星星当纸白冻住。
+static inline float s2a_hdr_lit_frac(const uint32_t hist[S2A_HDR_HIST_BINS]) {
+    uint64_t lit = 0, all = 0;
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) {
+        all += hist[i];
+        if (!s2a_hdr_bin_black(i)) lit += hist[i];
+    }
+    return all ? (float)((double)lit / (double)all) : 0.0f;
+}
+
+// 场景差 → 0..1 的「突变程度」。用两帧重心的 log2 差，低阈值以下为 0、高阈值以上为 1。
+static inline float s2a_hdr_scene_weight_opt(float prev_avg, float cur_avg, float low, float high) {
+    float d = cur_avg - prev_avg;
+    if (d < 0) d = -d;
+    if (!(high > low)) return (d > low) ? 1.0f : 0.0f;   // 退化成硬阈值，仍可用
+    if (!(d > low)) return 0.0f;
+    if (d >= high) return 1.0f;
+    float t = (d - low) / (high - low);
+    return t * t * (3.0f - 2.0f * t);   // smoothstep，避免阈值处跳变
+}
+
+static inline float s2a_hdr_scene_weight(float prev_avg, float cur_avg) {
+    return s2a_hdr_scene_weight_opt(prev_avg, cur_avg, S2A_HDR_SCENE_LOW, S2A_HDR_SCENE_HIGH);
+}
+
+// 白点变化同样是「切镜」的证据，而且比重心更灵：菜单 → 游戏、同亮度过场、UI 层级整体变暗，
+//   这些切换里**整帧重心几乎不动**（都是同一批中间调），但白点会跳一两档。只看 avg 的后果是
+//   平滑斜坡照走（29 帧），画面在新场景上先暗后亮地爬过去。
+//   判据复用心重心的同一组阈值（单位都是 stop，log2 比值），所以不需要新常数。
+static inline float s2a_hdr_scene_weight_white(float prev_white, float white) {
+    if (!(prev_white > 0.0f) || !(white > 0.0f)) return 0.0f;   // 一侧测不出：不作判据
+    return s2a_hdr_scene_weight(log2f(prev_white), log2f(white));
+}
+
+// 两路证据取大：任一路判定「切了」，就按切镜处理（coef = 1，一帧到位）。
+static inline float s2a_hdr_scene_fuse(float w_avg, float w_white) {
+    float w = (w_avg > w_white) ? w_avg : w_white;
+    if (!(w > 0.0f)) return 0.0f;
+    return (w > 1.0f) ? 1.0f : w;
+}
+
+// 帧率归一化：S2A_HDR_SMOOTH 是「60 Hz 下每帧走多少」。同一个时间常数在不同帧率下
+//   每帧系数必须换算，否则 120 Hz 收敛比 30 Hz 快 4 倍——S2Arm 有 30/60/120 三档，
+//   切换档位时画面会因为「平滑速度变了」而看起来像掉帧或抽动。
+//   coef_hz = 1 - (1 - coef60)^(60/hz)：把「每帧保留比例」按时间折算。
+#define S2A_HDR_SMOOTH_HZ 60.0f
+
+// 帧率估计：上屏路径拿不到「层的刷新率」，只能从两次回调的时间差自己算。
+// 为什么需要：coef 是「每帧走多少」，同一系数在 30/60/120 Hz 下每秒走的总量差 4 倍，
+// 切档或掉帧时画面行为会变（60→30 掉帧时收敛突然变慢一半，观感就是「卡一下才跟上」）。
+// 这里用 dt 的指数滑动平均（时间常数约 8 帧），再换算成 Hz；异常 dt 一律夹到 [1/240, 1/24]。
+#define S2A_HDR_HZ_MIN 24.0f
+#define S2A_HDR_HZ_MAX 240.0f
+#define S2A_HDR_HZ_TAU 8.0f
+
+static inline float s2a_hdr_hz_from_dt(double dt, float prev_hz) {
+    if (!(dt > 1e-4) || !(dt < 1.0)) return (prev_hz > 0.0f) ? prev_hz : S2A_HDR_SMOOTH_HZ;
+    float inst = (float)(1.0 / dt);
+    if (!(inst >= S2A_HDR_HZ_MIN)) inst = S2A_HDR_HZ_MIN;
+    if (inst > S2A_HDR_HZ_MAX) inst = S2A_HDR_HZ_MAX;
+    if (!(prev_hz > 0.0f)) return inst;
+    float a = 1.0f / (1.0f + S2A_HDR_HZ_TAU);
+    float hz = prev_hz + (inst - prev_hz) * a;
+    if (!(hz >= S2A_HDR_HZ_MIN)) hz = S2A_HDR_HZ_MIN;
+    if (hz > S2A_HDR_HZ_MAX) hz = S2A_HDR_HZ_MAX;
+    return hz;
+}
+
+static inline float s2a_hdr_coef_at_hz(float coef60, float hz) {
+    if (!(hz > 0.0f)) hz = S2A_HDR_SMOOTH_HZ;   // 0 / NaN / 负数都按参考帧率处理
+    if (hz < 1.0f) hz = 1.0f;
+    if (hz > 240.0f) hz = 240.0f;               // 上限只为防 powf 溢出，与真实档位无关
+    if (!(coef60 > 0.0f)) return 0.0f;
+    if (coef60 >= 1.0f) return 1.0f;
+    return 1.0f - powf(1.0f - coef60, S2A_HDR_SMOOTH_HZ / hz);
+}
+
+// 场景感知的平滑：突变越强，越少平滑（coef 从 SMOOTH 升到 1）。
+static inline float s2a_hdr_auto_step_l1(float prev_hi, float target_hi, float scene_w) {
+    float c = S2A_HDR_SMOOTH + (1.0f - S2A_HDR_SMOOTH) * scene_w;
+    float d = target_hi - prev_hi;
+    if (d < 0) d = -d;
+    if (d < S2A_HDR_DEADBAND && scene_w <= 0.0f) return prev_hi;   // 死区只管静止画面
+    return prev_hi + (target_hi - prev_hi) * c;
+}
+
+// 同上，但按实际帧率换算系数（hz<=0 或非有限 → 按 60 Hz）。
+static inline float s2a_hdr_auto_step_l1_hz(float prev_hi, float target_hi, float scene_w, float hz) {
+    float c = s2a_hdr_coef_at_hz(S2A_HDR_SMOOTH, hz);
+    c = c + (1.0f - c) * scene_w;
+    float d = target_hi - prev_hi;
+    if (d < 0) d = -d;
+    if (d < S2A_HDR_DEADBAND && scene_w <= 0.0f) return prev_hi;
+    return prev_hi + (target_hi - prev_hi) * c;
+}
+
+// L1 主入口：一次算齐 knee_hi / knee_lo / 白点 / 重心 / 场景权重。
+//   prev_hi  上一帧真正用的 knee_hi（首帧传 S2A_HDR_KNEE_MAX 之外的值也行，会被钳）
+//   prev_avg 上一帧的重心（首帧传 NaN/任意值，*first=1 时不做场景判断）
+typedef struct {
+    float knee_hi, knee_lo;
+    float white;      // 漫反射白点（线性亮度），0 = 未测出
+    float avg;        // 本帧 log2 重心
+    float scene;      // 0..1 突变程度
+    int   first;      // 1 = 这帧没有历史（调用方应直接采用 knee_hi，不做平滑）
+} s2a_hdr_auto_l1;
+
+static inline int s2a_hdr_auto_l1_step(const uint32_t hist[S2A_HDR_HIST_BINS],
+                                       float prev_hi, float prev_avg, int have_prev,
+                                       s2a_hdr_auto_l1 *out) {
+    if (!hist || !out) return 0;
+    // 上一帧状态可能是垃圾（首帧未初始化 / 驱动崩过 / 调用方传错）：非有限就当作没有历史。
+    if (have_prev && !(isfinite(prev_hi) && isfinite(prev_avg))) have_prev = 0;
+    int ok = 0;
+    float avg = s2a_hdr_hist_avg(hist, &ok);
+    if (!ok) return 0;                                   // 全黑：调用方保持上一帧
+    out->avg = avg;
+    out->first = !have_prev;
+    out->scene = have_prev ? s2a_hdr_scene_weight(prev_avg, avg) : 0.0f;
+
+    float white = 0.0f;
+    out->white = s2a_hdr_sdr_white(hist, &white) ? white : 0.0f;
+
+    // 目标 knee：有白点时以白点为基准（白点之上才扩张），否则退回 L0 的分位算法。
+    float hi;
+    if (out->white > 0.0f) {
+        hi = out->white / S2A_HDR_KNEE_TARGET;
+    } else {
+        float lo_unused;
+        if (!s2a_hdr_auto_knee(hist, &hi, &lo_unused)) return 0;
+    }
+    if (!(hi >= S2A_HDR_KNEE_L1_MIN)) hi = S2A_HDR_KNEE_L1_MIN;   // 兜 NaN
+    if (hi > S2A_HDR_KNEE_L1_MAX) hi = S2A_HDR_KNEE_L1_MAX;
+
+    out->knee_hi = out->first ? hi : s2a_hdr_auto_step_l1(prev_hi, hi, out->scene);
+    out->knee_lo = S2A_HDR_KNEE_RATIO * out->knee_hi;
+    return 1;
+}
+
+// ---------- L1b：把「纸白不动」做成硬约束（本轮新增，与上面的 L1 并存）----------
+// L1 的问题（量化测试 t_hdr_quality 里看得见）：白点 white 经 knee = white/S2A_HDR_KNEE_TARGET 得拐点，
+//   而 knee_lo = 0.55 * knee，于是 0.55/0.8 = 0.69 倍白点就开始吃增益 ⇒ 满屏 UI 白整体被抬到 ×1.27 纸白。
+//   RTX HDR 那类实现的语义是「纸白保持，白点之上的高光才扩张」。
+// L1b 就按这个语义做：knee_lo = 白点，knee_hi = SDR 裁切点(1.0)，两端各自平滑。
+//   暗场（白点 0.03）⇒ 0.03 之上全程缓抬，1.0 处拿满 head；亮场（白点 0.83）⇒ 纸白完全不动，只有近白高光抬。
+// 两端都要平滑，所以 lo 也进状态；旧 L1 只平滑 hi（lo 由 ratio 导出），这正是它把纸白抬起来的原因。
+static inline float s2a_hdr_auto_step_l1b_hz(float prev, float target, float scene_w, float hz) {
+    float coef = s2a_hdr_coef_at_hz(S2A_HDR_SMOOTH, hz);
+    coef = coef + (1.0f - coef) * scene_w;
+    if (coef > 1.0f) coef = 1.0f;
+    float v = prev + (target - prev) * coef;
+    return (v > target) == (prev > target) ? v : target;   // 不越过目标（避免两端互推超调）
+}
+
+static inline float s2a_hdr_auto_step_l1b(float prev, float target, float scene_w) {
+    return s2a_hdr_auto_step_l1b_hz(prev, target, scene_w, S2A_HDR_SMOOTH_HZ);
+}
+
+typedef struct {
+    float knee_lo, knee_hi;   // 线性亮度：lo 以下完全不动，hi 处拿满 head
+    float white, avg, scene;
+    int   first;
+    int   frozen;             // 1 = 本帧被判为淡出，一切保持上一帧（仅 fused 路径会置位）
+} s2a_hdr_auto_l1b;
+
+// 与 s2a_hdr_auto_l1_step 同输入多一个 prev_lo；返回 1 表示这一帧可用。
+// white_override > 0 时直接采用（HUD 剔除路径传入的稳健白点），否则自己算。
+// 目标区间（lo = 纸白，hi = SDR 裁切点）：把「看直方图决定两端」这段单独抽出来，
+// 好让「有直方图的路径」与「只有 float4 的路径」共用同一份判据（以前是两份，暗场判据已经分叉过一次）。
+// 返回 0 = 这一帧不可用（空直方图 / 白点与分位都测不出）。
+static inline int s2a_hdr_auto_l1b_targets(const uint32_t hist[S2A_HDR_HIST_BINS], float white_override,
+                                           float *pwhite, float *pavg, float *plo, float *phi) {
+    if (!hist) return 0;
+    int ok = 0;
+    float avg = s2a_hdr_hist_avg(hist, &ok);
+    if (!ok) return 0;                       // 没有高于真黑阈的像素：不可测
+    float white = 0.0f;
+    float w = s2a_hdr_sdr_white(hist, &white) ? white : 0.0f;
+    if (white_override > 0.0f) w = white_override;   // HUD 剔除后的稳健白点
+
+    float lo, hi;
+    float lit = s2a_hdr_lit_frac(hist);
+    // 暗场判据放在白点之前：星空这类「99.9% 纯黑 + 几颗星」的画面里，白点常常**测不出来**
+    //（顶部 0.5% 的边界落在纯黑格里），此时若先看白点就会掉进「白点未知」分支，
+    // 用 99.5 分位乘 0.8 得到 0.39 —— 整幅星空被冻住，这正是旧 GPU 代理的老毛病。
+    if (lit < S2A_HDR_DARK_FRAC) {
+        // 黑底画面（星空/纯黑过场）：白点是「唯一剩下的亮点」，不能当纸白冻住 —— 从近黑开始扩张
+        lo = S2A_HDR_DARK_FLOOR;
+        hi = S2A_HDR_SDR_CLIP;
+    } else if (w > 0.0f) {
+        lo = w;                              // 纸白：这是「不动」的那条线
+        hi = S2A_HDR_SDR_CLIP;               // 1.0
+    } else {
+        float lo_unused;
+        if (!s2a_hdr_auto_knee(hist, &hi, &lo_unused)) return 0;
+        lo = hi * S2A_HDR_KNEE_RATIO;
+    }
+    if (!(lo >= 0.002f)) lo = 0.002f;         // 兜 NaN / 0
+    if (lo > 0.95f) lo = 0.95f;               // 白点贴顶时留出可扩张区间
+    if (!(hi > lo + 0.02f)) hi = lo + 0.02f;  // 退化保护：区间不许塌
+    if (hi > 2.0f) hi = 2.0f;
+    *pwhite = w; *pavg = avg; *plo = lo; *phi = hi;
+    return 1;
+}
+
+static inline int s2a_hdr_auto_l1b_step_white_hz(const uint32_t hist[S2A_HDR_HIST_BINS], float white_override,
+                                        float prev_lo, float prev_hi, float prev_avg, int have_prev,
+                                        float hz, s2a_hdr_auto_l1b *out) {
+    if (!hist || !out) return 0;
+    // 三个上一帧量都要挡非有限值；lo > hi 这种反向状态也只能丢弃（否则插值会穿过目标）。
+    if (have_prev && !(isfinite(prev_lo) && isfinite(prev_hi) && isfinite(prev_avg) && prev_lo <= prev_hi))
+        have_prev = 0;
+    float w = 0.0f, avg = 0.0f, lo = 0.0f, hi = 0.0f;
+    if (!s2a_hdr_auto_l1b_targets(hist, white_override, &w, &avg, &lo, &hi)) return 0;
+    out->white = w; out->avg = avg;
+    out->first = !have_prev;
+    out->scene = have_prev ? s2a_hdr_scene_weight(prev_avg, avg) : 0.0f;
+    out->knee_lo = out->first ? lo : s2a_hdr_auto_step_l1b_hz(prev_lo, lo, out->scene, hz);
+    out->knee_hi = out->first ? hi : s2a_hdr_auto_step_l1b_hz(prev_hi, hi, out->scene, hz);
+    if (out->knee_hi <= out->knee_lo + 1e-4f) out->knee_hi = out->knee_lo + 1e-4f;
+    return 1;
+}
+
+// 上屏路径用的版本（nvn_hdr_hist.inc 通过 blit 把直方图拷回 CPU 后直接调这个）：
+// 与 step_white_hz 唯一的差别是场景判据多一路「白点变化」，见 s2a_hdr_scene_fuse。
+// 这样 GPU 侧不再有任何「代理判据」——用的就是 t_hdr_* 测的同一份代码。
+static inline int s2a_hdr_auto_l1b_step_fused_hz(const uint32_t hist[S2A_HDR_HIST_BINS], float white_override,
+                                        float prev_lo, float prev_hi, float prev_avg, float prev_white,
+                                        int have_prev, float hz, s2a_hdr_auto_l1b *out) {
+    if (!hist || !out) return 0;
+    if (have_prev && !(isfinite(prev_lo) && isfinite(prev_hi) && isfinite(prev_avg) && prev_lo <= prev_hi))
+        have_prev = 0;
+    float w = 0.0f, avg = 0.0f, lo = 0.0f, hi = 0.0f;
+    if (!s2a_hdr_auto_l1b_targets(hist, white_override, &w, &avg, &lo, &hi)) return 0;
+    if (have_prev && prev_white > 0.0f && w > 0.0f &&
+        fabsf(log2f(w / prev_white)) < S2A_HDR_WHITE_DEADBAND) {
+        // 落在死区内：白点保持上一帧。目标端要跟着一起冻结，否则 lo 仍是被量化跳变
+        // 拽过去的那个新值，knee_lo 照样来回抖（只有非暗场时纸白才等于 lo）。
+        w = prev_white;
+        if (lo > S2A_HDR_DARK_FLOOR * 1.0001f) {
+            lo = w;
+            if (!(lo >= 0.002f)) lo = 0.002f;
+            if (lo > 0.95f) lo = 0.95f;
+            if (!(hi > lo + 0.02f)) hi = lo + 0.02f;
+        }
+    }
+    out->frozen = 0;
+    if (have_prev) {
+        const int dim = avg < S2A_HDR_DIM_APL;
+        const int dim_prev = prev_avg < S2A_HDR_DIM_APL;
+        const float drop = prev_avg - avg;
+        // 每秒落差（stop/s）：判据的唯一单位，见 S2A_HDR_FADE_MIN_S 的注释
+        const float hz_ok = (hz >= 1.0f && hz <= 480.0f) ? hz : S2A_HDR_SMOOTH_HZ;
+        const float fade_rate = fabsf(drop) * hz_ok;
+
+        // 淡出/淡入：中速升降 + 白点同向变（整幅等比变暗/变亮）。
+        // 另外「白点测不出来（快黑透）且还在变暗」也冻结：这时没有可信纸白，
+        // 猜一个暗场落地值只会让回到画面时先闪一下（实测 205 帧落到 0.02、回来爬 30 帧）。
+        // 只按「每秒多少 stop」判，不按白点同向性判：冻结期间 prev_white 是陈旧的，
+        // 拿它和新测的白点比，淡入的第一帧必然看起来像「白点在反方向猛跳」而漏判。
+        const int uniform_fade = drop > 0.0f && fade_rate > S2A_HDR_FADE_MIN_S && fade_rate < S2A_HDR_FADE_MAX_S;
+        // 淡入（升）同样冻结：升亮过程中测出来的白点只是"当前有多亮"，不是这段内容的纸白；
+        // 跟着它走会把 knee 先拖低再抬回（270 帧序列实测 0.6579 → 0.0306 → 爬回）。
+        // 升亮同样冻结到「动作为止」：淡入结束时第一帧静止，之后的平滑会把 knee 收到新纸白
+        // （单调、不闪）；跟着变亮过程追白点会把 knee 先拖到 0.02 再爬回来，那正是要避免的。
+        // 变亮同样冻结（从黑淡入时追白点会把 knee 先拖到 0.02 再爬回，见 SEQUENCE.md）；
+        // 代价是交叉淡入结束时那一帧会按切镜判据一步到位（300 帧序列实测 0.1178 –
+        // 与内容真正切换同帧，属于设计内行为，不是抖动）。
+        const int uniform_rise = drop < 0.0f && fade_rate > S2A_HDR_FADE_MIN_S && fade_rate < S2A_HDR_FADE_MAX_S;
+        const int goes_black = (w <= 0.0f) && drop > 0.0f;
+        // 已经进入「黑底 + 少亮像素」区（淡到深处 / 过场全黑 / 从黑淡入）时，只要平均亮度还在动
+        // 就整帧冻结：这段没有可信纸白，任何重定目标都会在回到画面时被看见（先亮后收）。
+        // 稳态黑底（星空：不动）不冻结，仍然按暗场落地 0.02 扩张——那是刻意的行为，有单测守着。
+        const int deep_dark = avg < S2A_HDR_DIM_APL && s2a_hdr_lit_frac(hist) < S2A_HDR_DARK_FRAC;
+        const int dark_passage = deep_dark && fade_rate > S2A_HDR_FADE_MIN_S;
+        // 已经黑到测不出纸白、但上一帧的 knee 明显不是暗场落地值 ⇒ 这是「淡到黑/过场黑」，
+        // 保持着色前的 knee 不动。稳态星空从 0 起、prev_lo 一直是 0.02，不受这条影响。
+        // 这条覆盖整个「暗区进出」过程（含淡到黑后快速回亮的那几帧——那时一帧就能升 2 stop，
+        // 任何速度判据都会把它看成切镜）。
+        const int dim_any = dim || dim_prev;
+        const int dark_hold = dim_any && prev_lo > 5.0f * S2A_HDR_DARK_FLOOR;
+        if (uniform_fade || uniform_rise || goes_black || dark_passage || dark_hold) {
+            // 淡出中：冻结（不要跟着掉下去把中调抬亮）
+            out->white = prev_white; out->avg = avg; out->first = 0;
+            out->scene = 0.0f; out->knee_lo = prev_lo; out->knee_hi = prev_hi;
+            out->frozen = 1;
+            return 1;
+        }
+        if (!dim && dim_prev) {
+            // 从暗区回到有内容的画面：这就是一次切镜，别让它爬
+            out->white = w; out->avg = avg; out->first = 0;
+            out->scene = 1.0f;
+            out->knee_lo = lo; out->knee_hi = hi;
+            if (out->knee_hi <= out->knee_lo + 1e-4f) out->knee_hi = out->knee_lo + 1e-4f;
+            return 1;
+        }
+    }
+    out->white = w; out->avg = avg;
+    out->first = !have_prev;
+    out->scene = have_prev ? s2a_hdr_scene_fuse(s2a_hdr_scene_weight(prev_avg, avg),
+                                                s2a_hdr_scene_weight_white(prev_white, w))
+                           : 0.0f;
+    out->knee_lo = out->first ? lo : s2a_hdr_auto_step_l1b_hz(prev_lo, lo, out->scene, hz);
+    out->knee_hi = out->first ? hi : s2a_hdr_auto_step_l1b_hz(prev_hi, hi, out->scene, hz);
+    if (out->knee_hi <= out->knee_lo + 1e-4f) out->knee_hi = out->knee_lo + 1e-4f;
+    return 1;
+}
+
+static inline int s2a_hdr_auto_l1b_step_fused(const uint32_t hist[S2A_HDR_HIST_BINS], float white_override,
+                                        float prev_lo, float prev_hi, float prev_avg, float prev_white,
+                                        int have_prev, s2a_hdr_auto_l1b *out) {
+    return s2a_hdr_auto_l1b_step_fused_hz(hist, white_override, prev_lo, prev_hi, prev_avg, prev_white,
+                                          have_prev, S2A_HDR_SMOOTH_HZ, out);
+}
+
+// GPU 侧只有 float4 回读（hi, white, avg, scene），拿不到直方图：
+// 用 white 推出 L1b 的两个目标端（lo = 纸白，hi = SDR 裁切点），让上屏路径也遵守「纸白不动」。
+// 暗场判据用代理：白点低于 2% 白（S2A_HDR_DARK_WHITE）就当黑底画面，lo 落到 DARK_FLOOR。
+// 返回 0 = white 不可用，调用方退回 L1 的分位路径。
+static inline int s2a_hdr_l1b_targets_from_white(float white, float *lo, float *hi) {
+    if (!(white > 0.0f)) return 0;
+    float l = (white < S2A_HDR_DARK_WHITE) ? S2A_HDR_DARK_FLOOR : white;
+    if (l < 0.002f) l = 0.002f;
+    if (l > 0.95f) l = 0.95f;                 // 白点贴顶时留出可扩张区间
+    float h = S2A_HDR_SDR_CLIP;
+    if (!(h > l + 0.02f)) h = l + 0.02f;      // 退化保护：区间不许塌
+    *lo = l;
+    *hi = h;
+    return 1;
+}
+
+// 60 Hz 兼容包装（老调用点 / GPU 侧历史行为不变）
+static inline int s2a_hdr_auto_l1b_step_white(const uint32_t hist[S2A_HDR_HIST_BINS], float white_override,
+                                        float prev_lo, float prev_hi, float prev_avg, int have_prev,
+                                        s2a_hdr_auto_l1b *out) {
+    return s2a_hdr_auto_l1b_step_white_hz(hist, white_override, prev_lo, prev_hi, prev_avg, have_prev,
+                                          S2A_HDR_SMOOTH_HZ, out);
+}
+
+#endif
+
+// 兼容入口：不带白点覆盖，等于自算白点。
+static inline int s2a_hdr_auto_l1b_step(const uint32_t hist[S2A_HDR_HIST_BINS],
+                                        float prev_lo, float prev_hi, float prev_avg, int have_prev,
+                                        s2a_hdr_auto_l1b *out) {
+    return s2a_hdr_auto_l1b_step_white(hist, 0.0f, prev_lo, prev_hi, prev_avg, have_prev, out);
+}
diff --git a/graphics/nvn/gfx/nvn/nvn_hdr_hist.inc b/graphics/nvn/gfx/nvn/nvn_hdr_hist.inc
new file mode 100644
index 00000000..73b808c7
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_hdr_hist.inc
@@ -0,0 +1,214 @@
+// 自动 HDR 的 GPU 侧：每 N 帧扫一遍画面亮度分布，算 99.5 分位 → 改 g_hdr_knee。
+//   算法与 nvn_hdr_auto.h（CPU 参考，t_hdr_auto 29 项守着）同一组常数；
+//   kernel 在 graphics/nvn/shaders/hdr_hist.metal，Makefile 嵌成 k_hdr_hist。
+// 开关 S2A_HDR_AUTO=1（缺省 0）：关着时 present 用 s2a_hdr_itm_params() 的固定 knee，与之前逐字节一致。
+#include "nvn_hdr_hist_msl.h"
+#include "nvn_hdr_auto.h"      // L0 常数（HIST_BINS / KNEE_RATIO / HIST_EVERY）
+#include "nvn_hdr_auto_l1.h"
+#include <time.h>   // clock_gettime：帧率估计（Darwin 上同样是 CLOCK_MONOTONIC）   // L1：白点 / 黑场 / 场景平滑（s2a_hdr_auto_step_l1）
+
+@interface NvHdrHist : NSObject {
+@public
+    id<MTLBuffer> hist;                          // 256 × uint32，GPU 私有
+    id<MTLBuffer> out;                           // float4(hi, white, avg, scene)，shared，CPU 可读
+    id<MTLBuffer> histcpu[2];                    // 256 × uint32 的 CPU 副本（blit 拷回），shared；双槽防跨帧竞争
+    unsigned      hs;                            // 双槽轮转
+    id<MTLComputePipelineState> ps_clear, ps_add, ps_l1;
+    NSUInteger w, h;
+    float prev_avg;                              // 上一帧的 log2 重心（场景判据用）
+    float prev_white;                            // 上一帧的白点（第二个场景判据：重心不动也认）
+    int have_prev;
+    double last_t;                               // 上一帧的时间戳（秒）：帧率估计用
+    float hz;                                    // 估计出的帧率（平滑过），喂给 coef
+    uint64_t frame;                              // 已跳过多少帧
+    uint64_t logf;                               // 诊断行节拍（S2A_HDR_LOG）
+    unsigned gen;                                // 每次重建 +1：回调里用它判断「这份数据是否还属于当前对象」
+}
+@end
+@implementation NvHdrHist @end
+
+static NvHdrHist *g_hh;
+static unsigned g_hh_gen;   // 单调递增：重建对象时换一代，旧命令缓冲的回调据此作废
+
+static int hdr_log_setting(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("S2A_HDR_LOG"); v = (e != NULL && *e != '\0' && *e != '0'); }
+    return v;
+}
+
+static int hdr_auto_setting(void) {
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("S2A_HDR_AUTO"); v = !(e == NULL || *e == '0'); }
+    return v;
+}
+
+static id<MTLComputePipelineState> hh_pipeline(id<MTLLibrary> lib, NSString *name) {
+    id<MTLFunction> fn = [lib newFunctionWithName:name];
+    if (!fn) { MLOG("【红】自动 HDR：shader 里没有 %s", name.UTF8String); return nil; }
+    NSError *e = nil;
+    id<MTLComputePipelineState> ps = [g_dev newComputePipelineStateWithFunction:fn error:&e];
+    if (!ps) MLOG("【红】自动 HDR：%s 建不了管线 %s", name.UTF8String, e.localizedDescription.UTF8String);
+    return ps;
+}
+
+static NvHdrHist *hdr_hist_prepare(NSUInteger w, NSUInteger h) {
+    if (g_hh && g_hh->w == w && g_hh->h == h && g_hh->ps_l1) return g_hh;
+    if (g_hh) {
+        if (g_hh->hist) res_remove(g_hh->hist);
+        if (g_hh->out) res_remove(g_hh->out);
+        if (g_hh->histcpu[0]) res_remove(g_hh->histcpu[0]);
+        if (g_hh->histcpu[1]) res_remove(g_hh->histcpu[1]);
+        g_hh = nil;
+    }
+    if (!w || !h) return nil;
+    NSError *e = nil;
+    id<MTLLibrary> lib = [g_dev newLibraryWithSource:@(k_hdr_hist) options:nil error:&e];
+    if (!lib) { MLOG("【红】自动 HDR：shader 编译失败 %s", e.localizedDescription.UTF8String); return nil; }
+    NvHdrHist *f = [NvHdrHist new];
+    f->ps_clear = hh_pipeline(lib, @"hdr_hist_clear");
+    f->ps_add = hh_pipeline(lib, @"hdr_hist_add");
+    f->ps_l1 = hh_pipeline(lib, @"hdr_hist_l1");
+    if (!f->ps_clear || !f->ps_add || !f->ps_l1) return nil;
+    f->hist = [g_dev newBufferWithLength:256 * sizeof(uint32_t) options:MTLResourceStorageModePrivate];
+    f->out = [g_dev newBufferWithLength:sizeof(float) * 4 options:MTLResourceStorageModeShared];
+    // 直方图本体留在 GPU 私有内存（原子加最快），每 S2A_HDR_HIST_EVERY 帧用 blit 拷 1 KB 回 CPU：
+    //   有了真直方图，上屏判据就和 t_hdr_* 测的是同一份代码，不再需要「白点 < 2%」这种代理。
+    for (int i = 0; i < 2; i++)
+        f->histcpu[i] = [g_dev newBufferWithLength:256 * sizeof(uint32_t) options:MTLResourceStorageModeShared];
+    if (!f->hist || !f->out || !f->histcpu[0] || !f->histcpu[1]) { MLOG("【红】自动 HDR：建不了 buffer"); return nil; }
+    res_add(f->hist); res_add(f->out); res_add(f->histcpu[0]); res_add(f->histcpu[1]);
+    f->w = w; f->h = h;
+    f->gen = ++g_hh_gen;
+    g_hh = f;
+    MLOG("自动 HDR：直方图就绪 %lux%lu（每 %d 帧一次）", (unsigned long)w, (unsigned long)h, S2A_HDR_HIST_EVERY);
+    return f;
+}
+
+// 每 S2A_HDR_HIST_EVERY 帧跑一次：clear → add（4×4 采样）→ hdr_hist_l1，结果回读 16 B 进 g_hdr_knee
+static void hdr_hist_tick(id<MTLCommandBuffer> cb, id<MTLTexture> src) {
+    if (!hdr_auto_setting() || !src) return;
+    NvHdrHist *f = hdr_hist_prepare(src.width, src.height);
+    if (!f) return;
+    if ((f->frame++ % S2A_HDR_HIST_EVERY) != 0) return;
+    @autoreleasepool {
+        id<MTLComputeCommandEncoder> en = [cb computeCommandEncoder];
+        if (!en) return;
+        // 双槽：本帧 blit 进 slot，下一个 tick（S2A_HDR_HIST_EVERY 帧后）进另一个槽，
+        //   CPU 读完前不会被覆盖；落后超过两个 tick 时只会读到较新的数据，不会读到半写状态。
+        unsigned slot = (f->hs++) & 1u;
+        id<MTLBuffer> hb = f->histcpu[slot];
+        if (!hb) return;
+        uint32_t stride = (src.width >= 2560 || src.height >= 1440) ? 8u : 4u;
+        uint32_t linearize = (src.pixelFormat == MTLPixelFormatRGBA16Float) ? 0u : 1u;
+        [en setComputePipelineState:f->ps_clear];
+        [en setBuffer:f->hist offset:0 atIndex:0];
+        [en dispatchThreads:MTLSizeMake(256, 1, 1) threadsPerThreadgroup:MTLSizeMake(64, 1, 1)];
+        [en setComputePipelineState:f->ps_add];
+        [en setTexture:src atIndex:0];   // read() 不解码 sRGB，直接读存储原字节，不用转 view
+        [en setBuffer:f->hist offset:0 atIndex:0];
+        [en setBytes:&stride length:sizeof stride atIndex:1];
+        [en setBytes:&linearize length:sizeof linearize atIndex:2];
+        [en dispatchThreads:MTLSizeMake(src.width, src.height, 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+        [en setComputePipelineState:f->ps_l1];
+        [en setBuffer:f->hist offset:0 atIndex:0];
+        [en setBuffer:f->out offset:0 atIndex:1];
+        float pavg = f->prev_avg; uint32_t have_prev = (uint32_t)f->have_prev;
+        [en setBytes:&pavg length:sizeof pavg atIndex:2];
+        [en setBytes:&have_prev length:sizeof have_prev atIndex:3];
+        [en dispatchThreads:MTLSizeMake(1, 1, 1) threadsPerThreadgroup:MTLSizeMake(1, 1, 1)];
+        [en endEncoding];
+        // 把 1 KB 直方图拷回 CPU 可见缓冲：判定全部在 CPU 侧按「真直方图」算，
+        // GPU 只负责数格子。blit 在 30 帧里发生一次，开销可忽略。
+        id<MTLBlitCommandEncoder> be = [cb blitCommandEncoder];
+        if (be) {
+            [be copyFromBuffer:f->hist sourceOffset:0
+                      toBuffer:hb destinationOffset:0
+                          size:256 * sizeof(uint32_t)];
+            [be endEncoding];
+        }
+        NvHdrHist *owner = f; unsigned gen = f->gen;
+        [cb addCompletedHandler:^(id<MTLCommandBuffer> b) {
+            // 以「对象 + 代号」双重判定：分辨率改变会释放并重建 buffer，此时旧命令缓冲的回调
+            //   既不该读新对象的 prev_*，也不该把旧直方图的结论写进 g_hdr_knee。
+            if (b.error || !g_hh || g_hh != owner || owner->gen != gen || !owner->out) return;
+            float v[4]; memcpy(v, g_hh->out.contents, sizeof v);   // (hi, white, avg, scene)：GPU 版本的结果，留作对账
+            if (!(v[0] > 0.0f)) return;                            // 空帧 / 全黑：保持上一帧
+            NvHdrHist *h = g_hh;
+            const uint32_t *hist = (const uint32_t *)hb.contents;
+            float cur_lo = g_hdr_knee[0];
+            float cur_hi = g_hdr_knee[0] + g_hdr_knee[1];
+            s2a_hdr_auto_l1b b;
+            // 真直方图路径：与 t_hdr_* 完全同一份判定（纸白、暗场、HUD 视角都能精确判）
+            // 有直方图就不必再靠代理：HUD 孤立高光剔除（sdr_white_bulk）也能在 CPU 侧先做，
+            // 于是上屏路径与 t_hdr_* 走的是同一份「纸白 / 暗场 / HUD」判定。
+            float wov = 0.0f, wbulk = 0.0f;
+            if (s2a_hdr_sdr_white_bulk(hist, &wbulk)) wov = wbulk;
+            // 帧率：从两次回调的时间差估（拿不到层刷新率）。掉帧/切档时 coef 跟着变，
+            // 否则 30 Hz 下每秒只走一半、120 Hz 下四倍，观感就是「切档后过渡速度变了」。
+            struct timespec ts;
+            double now = 0.0;
+            if (clock_gettime(CLOCK_MONOTONIC, &ts) == 0) now = (double)ts.tv_sec + (double)ts.tv_nsec * 1e-9;
+            if (now > 0.0) {
+                h->hz = s2a_hdr_hz_from_dt(now - h->last_t, h->hz);
+                h->last_t = now;
+            }
+            float hz = (h->hz > 0.0f) ? h->hz : S2A_HDR_SMOOTH_HZ;
+            if (s2a_hdr_auto_l1b_step_fused_hz(hist, wov, cur_lo, cur_hi, h->prev_avg, h->prev_white,
+                                               h->have_prev, hz, &b)) {
+                // 先发原子槽（渲染线程只认它），再更新 CPU 侧记账，两处值一致
+                s2a_hdr_knee_publish(&g_hdr_knee_pub, b.knee_lo, b.knee_hi - b.knee_lo);
+                g_hdr_knee[0] = b.knee_lo;
+                g_hdr_knee[1] = b.knee_hi - b.knee_lo;
+                g_hdr_knee[3] = 1.0f;
+                // 一次对账日志：GPU 的 float4 与 CPU 直方图算出的白点/重心应一致（差 >0.02 就是两边分叉了）
+                if (!h->have_prev ||
+                    fabsf(b.white - v[1]) > 0.02f || fabsf(b.avg - v[2]) > 0.05f) {
+                    MLOG("自动 HDR：GPU/CPU 对账 white %.4f/%.4f avg %.4f/%.4f（差大就是 kernel 与头文件分叉）",
+                         (double)v[1], (double)b.white, (double)v[2], (double)b.avg);
+                }
+                if (hdr_log_setting() && (h->logf++ % S2A_HDR_LOG_EVERY) == 0) {
+                    s2a_hdr_stat st;
+                    memset(&st, 0, sizeof st);
+                    st.fmt16 = 1;              // 能跑到这里说明 HDR 链路在跑（画布是 16F 且开了 S2A_HDR_AUTO）
+                    st.itm = 1;
+                    st.frozen = b.frozen;
+                    st.head = g_hdr_knee[2];
+                    st.knee_lo = b.knee_lo; st.knee_hi = b.knee_hi;
+                    st.white = b.white; st.avg = b.avg; st.scene = b.scene;
+                    st.map = s2a_hdr_map();   // 0 = 拐点（缺省），1 = BT.2408 内容映射（此时 knee 只是日志）
+                    char line[192];
+                    s2a_hdr_status_line(line, sizeof line, &st);
+                    MLOG("%s", line);
+                }
+                h->prev_avg = b.avg; h->prev_white = b.white; h->have_prev = 1;
+                return;
+            }
+            // 直方图读不出来（blit 没跑 / 缓冲被回收）：退回旧的 float4 代理路径
+            float scene = h->have_prev
+                        ? s2a_hdr_scene_fuse(v[3], s2a_hdr_scene_weight_white(h->prev_white, v[1]))
+                        : 0.0f;
+            float tgt_lo = 0.0f, tgt_hi = 0.0f;
+            if (s2a_hdr_l1b_targets_from_white(v[1], &tgt_lo, &tgt_hi)) {
+                float lo = (g_hdr_knee[3] != 0.0f) ? s2a_hdr_auto_step_l1b_hz(cur_lo, tgt_lo, scene, hz) : tgt_lo;
+                float hi = (g_hdr_knee[3] != 0.0f) ? s2a_hdr_auto_step_l1b_hz(cur_hi, tgt_hi, scene, hz) : tgt_hi;
+                if (!(hi > lo + 1e-4f)) hi = lo + 1e-4f;
+                if (fabsf(lo - cur_lo) > 1e-6f || fabsf(hi - cur_hi) > 1e-6f || g_hdr_knee[3] == 0.0f) {
+                    s2a_hdr_knee_publish(&g_hdr_knee_pub, lo, hi - lo);
+                    g_hdr_knee[0] = lo;
+                    g_hdr_knee[1] = hi - lo;
+                    g_hdr_knee[3] = 1.0f;
+                }
+            } else {
+                float nxt_hi = (g_hdr_knee[3] != 0.0f) ? s2a_hdr_auto_step_l1(cur_hi, v[0], scene) : v[0];
+                if (fabsf(nxt_hi - cur_hi) > 1e-6f || g_hdr_knee[3] == 0.0f) {
+                    float lo = S2A_HDR_KNEE_RATIO * nxt_hi;
+                    s2a_hdr_knee_publish(&g_hdr_knee_pub, lo, nxt_hi - lo);
+                    g_hdr_knee[0] = lo;
+                    g_hdr_knee[1] = nxt_hi - lo;
+                    g_hdr_knee[3] = 1.0f;
+                }
+            }
+            h->prev_avg = v[2]; h->prev_white = v[1]; h->have_prev = 1;
+        }];
+    }
+}
diff --git a/graphics/nvn/gfx/nvn/nvn_hdr_msl.h b/graphics/nvn/gfx/nvn/nvn_hdr_msl.h
new file mode 100644
index 00000000..735e94b2
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_hdr_msl.h
@@ -0,0 +1,107 @@
+// 上屏 MSL（`src/nvn_mtl.m` 内联的 `src_msl_hdr`）的逐行 C 转写。
+//
+// 为什么单独成头文件：单测 `t_hdr_shader_mirror.c` 要在色彩空间网格上对账，
+// 图像级工具 `tools/hdr_shader_image.c` 要在**真实照片的每个像素**上对账。
+// 两边必须用同一份转写，否则「网格对上了、照片没对上」这类分歧会被掩盖。
+//
+// 与 MSL 原文的对应关系写在各函数上；改动 MSL 时必须同时改这里，`check_msl.py` 只守语法与常数，
+// 语义一致性靠 `t_hdr_shader_mirror`（网格）与 `hdr_shader_image`（整幅）两道闸。
+#ifndef S2A_NVN_HDR_MSL_H
+#define S2A_NVN_HDR_MSL_H
+#include <math.h>
+
+// ——— 逐行翻译自 src/nvn_mtl.m 的 src_msl_hdr（fs 主体）———
+static inline float msl_lin(float c) { return c <= 0.04045f ? c / 12.92f : powf((c + 0.055f) / 1.055f, 2.4f); }
+static inline float msl_lab_f(float t) { return t > 0.008856f ? powf(t, 1.0f / 3.0f) : (7.787f * t + 16.0f / 116.0f); }
+static inline float msl_lab_finv(float t) { float t3 = t * t * t; return t3 > 0.008856f ? t3 : (t - 16.0f / 116.0f) / 7.787f; }
+
+static void msl_lin_lab(const float rgb[3], float lab[3]) {
+    float x = 0.4124564f * rgb[0] + 0.3575761f * rgb[1] + 0.1804375f * rgb[2];
+    float y = 0.2126729f * rgb[0] + 0.7151522f * rgb[1] + 0.0721750f * rgb[2];
+    float z = 0.0193339f * rgb[0] + 0.1191920f * rgb[1] + 0.9503041f * rgb[2];
+    lab[0] = 116.0f * msl_lab_f(y) - 16.0f;
+    lab[1] = 500.0f * (msl_lab_f(x / 0.95047f) - msl_lab_f(y));
+    lab[2] = 200.0f * (msl_lab_f(y) - msl_lab_f(z / 1.08883f));
+}
+static void msl_lab_lin(const float lab[3], float rgb[3]) {
+    float fy = (lab[0] + 16.0f) / 116.0f, fx = fy + lab[1] / 500.0f, fz = fy - lab[2] / 200.0f;
+    float x = 0.95047f * msl_lab_finv(fx), y = msl_lab_finv(fy), z = 1.08883f * msl_lab_finv(fz);
+    rgb[0] = 3.2404542f * x - 1.5371385f * y - 0.4985314f * z;
+    rgb[1] = -0.9692660f * x + 1.8760108f * y + 0.0415560f * z;
+    rgb[2] = 0.0556434f * x - 0.2040259f * y + 1.0572252f * z;
+}
+// MSL `s2a_clip_head` 的逐行转写：超 head 等比缩放、负值夹 0。
+static void msl_clip_head(const float in[3], float head, float out[3]) {
+    if (!(head > 0.0f)) head = 1.0f;
+    float m = in[0] > in[1] ? in[0] : in[1];
+    if (in[2] > m) m = in[2];
+    float k = (m > head) ? head / m : 1.0f;
+    for (int i = 0; i < 3; i++) { float v = in[i] * k; out[i] = v > 0.0f ? v : 0.0f; }
+}
+
+static float msl_sat_min(const float lab[3], float s) {
+    float l2[3] = {lab[0], lab[1] * s, lab[2] * s}, rgb[3];
+    msl_lab_lin(l2, rgb);
+    return fminf(rgb[0], fminf(rgb[1], rgb[2]));
+}
+static void msl_sat(const float in[3], float sat, float out[3]) {
+    if (sat == 1.0f) { out[0] = in[0]; out[1] = in[1]; out[2] = in[2]; return; }
+    float lab[3];
+    msl_lin_lab(in, lab);
+    if (fabsf(lab[1]) < 1e-3f && fabsf(lab[2]) < 1e-3f) { out[0] = in[0]; out[1] = in[1]; out[2] = in[2]; return; }
+    float s = sat;
+    if (msl_sat_min(lab, s) < 0.0f) {
+        float lo = 1.0f, hi = s;
+        for (int i = 0; i < 14; i++) {
+            float mid = 0.5f * (lo + hi);
+            if (msl_sat_min(lab, mid) >= 0.0f) lo = mid; else hi = mid;
+        }
+        s = lo;
+    }
+    float l2[3] = {lab[0], lab[1] * s, lab[2] * s}, o[3];
+    msl_lab_lin(l2, o);
+    out[0] = fmaxf(0.0f, o[0]); out[1] = fmaxf(0.0f, o[1]); out[2] = fmaxf(0.0f, o[2]);
+}
+
+// 完整 fs：编码值 → 线性 → P3（可选）→ 饱和度（可选）→ Rec.709 亮度 → smoothstep → 乘 gain
+static void msl_fs_map(const float code[3], float lo, float hi, float head, float sat, float p3, int map, float out[3]) {
+    float a[3];
+    for (int i = 0; i < 3; i++) a[i] = msl_lin(code[i]);
+    if (p3 > 0.0f) {
+        static const float m[3][3] = {
+            {0.822582f, 0.177418f, 0.000000f},
+            {0.033197f, 0.966803f, 0.000000f},
+            {0.017100f, 0.072400f, 0.910500f},
+        };
+        float t = fminf(fmaxf(p3, 0.0f), 1.0f), pc[3];
+        for (int i = 0; i < 3; i++) {
+            float v = m[i][0] * a[0] + m[i][1] * a[1] + m[i][2] * a[2];
+            pc[i] = a[i] + (v - a[i]) * t;
+        }
+        for (int i = 0; i < 3; i++) a[i] = pc[i];
+    }
+    if (sat != 1.0f) {
+        float g[3];
+        msl_sat(a, sat, g);
+        for (int i = 0; i < 3; i++) a[i] = g[i];
+    }
+    float y = 0.2126f * a[0] + 0.7152f * a[1] + 0.0722f * a[2];
+    if (map == 1) {                       // BT.2408：与 knee 分支互斥，且先于退化拐点判定
+        float kb = (y > 0.0f) ? head * powf(y, 0.15f) : 0.0f;   // S2A_HDR_BT2408_GAMMA - 1
+        for (int i = 0; i < 3; i++) a[i] *= kb;
+        msl_clip_head(a, head, out);
+        return;
+    }
+    if (!(hi > lo + 1e-5f)) { for (int i = 0; i < 3; i++) a[i] *= head; msl_clip_head(a, head, out); return; }
+    float u = fminf(fmaxf((y - lo) / (hi - lo), 0.0f), 1.0f);
+    float k = 1.0f + (head - 1.0f) * (u * u * (3.0f - 2.0f * u));
+    for (int i = 0; i < 3; i++) a[i] *= k;
+    msl_clip_head(a, head, out);
+}
+
+// `c.extra.z` 缺省 0 ⇒ msl_fs 就是 knee 方案（现有调用点全走这里，逐位不变）
+static void msl_fs(const float code[3], float lo, float hi, float head, float sat, float p3, float out[3]) {
+    msl_fs_map(code, lo, hi, head, sat, p3, 0, out);
+}
+
+#endif
diff --git a/graphics/nvn/gfx/nvn/nvn_hdr_msl_hist.h b/graphics/nvn/gfx/nvn/nvn_hdr_msl_hist.h
new file mode 100644
index 00000000..a001187a
--- /dev/null
+++ b/graphics/nvn/gfx/nvn/nvn_hdr_msl_hist.h
@@ -0,0 +1,127 @@
+// 设备侧直方图链路的逐行 C 转写：分箱（hdr_hist_add）+ 分位→knee（hdr_hist_knee）。
+//
+// 为什么单独成头文件：单测（t_hdr_bin_mirror / t_hdr_knee_mirror）分别守住这两步，
+// 而设备上它们是**串起来**的（kernel 铺直方图 → 回调里算 knee → 写 g_hdr_knee）。
+// tools/hdr_device_image.c 用同一份转写跑整幅图，验证「设备算出的 knee」与「CPU 算出的 knee」
+// 在真实内容上一致，因此转写必须只有一份。
+//
+// 两处已修的真分歧都体现在这里：
+//   1) 黑像素进 0 号格（旧版整帧跳过 ⇒ lit_frac 恒 1.0 ⇒ 暗场分支在设备上从不执行）；
+//   2) 分位阈值用整数千分 (total*995)/1000（旧版 float 乘法在 1,515,877 个总数上少 1 ⇒ hi 差一格）。
+#ifndef S2A_NVN_HDR_MSL_HIST_H
+#define S2A_NVN_HDR_MSL_HIST_H
+#include <math.h>
+#include <string.h>
+#include <stdint.h>
+#include "nvn_hdr_auto.h"
+
+#define S2A_MSL_HIST_LO (-10.0f)
+#define S2A_MSL_HIST_HI (4.0f)
+
+// 逐行翻译自 src/hdr_hist.metal 的 hdr_hist_add：y=0 与负数进 0 号格，非有限值夹最高格。
+static inline int s2a_msl_hist_bin(float y) {
+    if (!(y > 0.0f)) return 0;
+    if (!isfinite(y)) return S2A_HDR_HIST_BINS - 1;
+    float l = (log2f(y) - S2A_MSL_HIST_LO) / (S2A_MSL_HIST_HI - S2A_MSL_HIST_LO);
+    l = l < 0.0f ? 0.0f : (l > 0.9999999f ? 0.9999999f : l);
+    return (int)(unsigned)(l * 256.0f);
+}
+
+// 逐行翻译自 src/hdr_hist.metal 的 hdr_hist_knee（整数千分阈值版）。
+static inline int s2a_msl_hist_knee(const uint32_t h[S2A_HDR_HIST_BINS], float *hi, float *lo, int *hit_out) {
+    unsigned long total = 0ul;
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) total += (unsigned long)h[i];
+    if (total == 0ul) return 0;
+    unsigned long target = (total * 995ul) / 1000ul;
+    if (target < 1ul) target = 1ul;
+    unsigned long acc = 0ul, hit = (unsigned long)(S2A_HDR_HIST_BINS - 1);
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) {
+        acc += (unsigned long)h[i];
+        if (acc >= target) { hit = (unsigned long)i; break; }
+    }
+    float edge = exp2f(S2A_MSL_HIST_LO + (S2A_MSL_HIST_HI - S2A_MSL_HIST_LO) * ((float)hit + 1.0f) / (float)S2A_HDR_HIST_BINS);
+    float hh = edge / 0.8f;
+    hh = hh < 0.25f ? 0.25f : (hh > 1.0f ? 1.0f : hh);
+    *hi = hh;
+    *lo = 0.55f * hh;
+    if (hit_out) *hit_out = (int)hit;
+    return 1;
+}
+
+// —— 逐行翻译自 src/hdr_hist.metal 的 hdr_hist_l1（白点 / 重心 / 切镜权重）——
+// 用途：这条 kernel 在设备上只做两件事——① 与 CPU 直方图结论对账（差 >0.02/0.05 就 MLOG），
+// ② blit 读不到直方图时作为 fallback。两者的正确性都依赖它和 CPU 参考实现同口径。
+#define S2A_MSL_KBLACKCUT (-6.0f)
+#define S2A_MSL_KAVGCUT (-9.5f)
+#define S2A_MSL_KWHITEFRAC 0.005f
+#define S2A_MSL_KKNEETARGET 0.8f
+#define S2A_MSL_KL1HIMIN 0.01f
+#define S2A_MSL_KL1HIMAX 2.0f
+#define S2A_MSL_KSCENELOW 0.40f
+#define S2A_MSL_KSCENEHIGH 1.10f
+
+static inline float s2a_msl_bin_low(int i) {
+    return S2A_MSL_HIST_LO + (float)i * ((S2A_MSL_HIST_HI - S2A_MSL_HIST_LO) / (float)S2A_HDR_HIST_BINS);
+}
+static inline float s2a_msl_bin_center(int i) {
+    return S2A_MSL_HIST_LO + ((float)i + 0.5f) * ((S2A_MSL_HIST_HI - S2A_MSL_HIST_LO) / (float)S2A_HDR_HIST_BINS);
+}
+static inline float s2a_msl_bin_edge(int i) {
+    return S2A_MSL_HIST_LO + ((float)i + 1.0f) * ((S2A_MSL_HIST_HI - S2A_MSL_HIST_LO) / (float)S2A_HDR_HIST_BINS);
+}
+static inline float s2a_msl_scene_weight(float prev_avg, float cur_avg) {
+    float d = fabsf(cur_avg - prev_avg);
+    if (!(d > S2A_MSL_KSCENELOW)) return 0.0f;
+    if (d >= S2A_MSL_KSCENEHIGH) return 1.0f;
+    float t = (d - S2A_MSL_KSCENELOW) / (S2A_MSL_KSCENEHIGH - S2A_MSL_KSCENELOW);
+    return t * t * (3.0f - 2.0f * t);
+}
+
+// out = (hi, white, avg, scene)；返回 0 表示空帧/全黑（调用方保持上一帧）
+static inline int s2a_msl_hist_l1(const uint32_t h[S2A_HDR_HIST_BINS], float prev_avg, int have_prev, float out[4]) {
+    unsigned long total = 0ul;
+    float acc = 0.0f, all = 0.0f;
+    for (int i = 0; i < S2A_HDR_HIST_BINS; i++) {
+        uint32_t c = h[i];
+        if (c == 0u) continue;
+        all += (float)c;
+        if (s2a_msl_bin_low(i) < S2A_MSL_KAVGCUT) continue;
+        total += (unsigned long)c;
+        acc += s2a_msl_bin_center(i) * (float)c;
+    }
+    if (!(all > 0.0f) || total == 0ul) { out[0] = out[1] = out[2] = out[3] = 0.0f; return 0; }
+    float avg = acc / (float)total;
+
+    unsigned long need = (unsigned long)((float)total * S2A_MSL_KWHITEFRAC);
+    if (need < 1ul) need = 1ul;
+    float white = 0.0f;
+    int found = 0;
+    for (int i = S2A_HDR_HIST_BINS - 1; i >= 0; i--) {
+        if (s2a_msl_bin_low(i) < S2A_MSL_KBLACKCUT) break;
+        if ((unsigned long)h[i] >= need) { white = exp2f(s2a_msl_bin_edge(i)); found = 1; break; }
+    }
+    float hi;
+    if (found) {
+        hi = white / S2A_MSL_KKNEETARGET;
+        if (!(hi >= S2A_MSL_KL1HIMIN)) hi = S2A_MSL_KL1HIMIN;
+        if (hi > S2A_MSL_KL1HIMAX) hi = S2A_MSL_KL1HIMAX;
+    } else {
+        // 与 L0 同口径的整数千分（原 kernel 这里写 float，和 hdr_hist_knee 修前同病）
+        unsigned long target = (total * 995ul) / 1000ul;
+        if (target < 1ul) target = 1ul;
+        unsigned long a2 = 0ul;
+        int hit = S2A_HDR_HIST_BINS - 1;
+        for (int i = 0; i < S2A_HDR_HIST_BINS; i++) {
+            a2 += (unsigned long)h[i];
+            if (a2 >= target) { hit = i; break; }
+        }
+        hi = exp2f(s2a_msl_bin_edge(hit)) / S2A_MSL_KKNEETARGET;
+        if (hi < 0.25f) hi = 0.25f;
+        if (hi > 1.0f) hi = 1.0f;
+    }
+    float sc = have_prev ? s2a_msl_scene_weight(prev_avg, avg) : 0.0f;
+    out[0] = hi; out[1] = white; out[2] = avg; out[3] = sc;
+    return 1;
+}
+
+#endif
